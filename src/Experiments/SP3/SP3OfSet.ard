\import SymmetricProducts.BSn
\import SymmetricProducts.Borel
\import Data.Or
\import Data.Fin
\import Function.Meta
\import Meta
\import SymmetricProducts.SP2
\import SymmetricProducts.SP2OfSet
\import Paths
\import Paths.Meta
\import Logic
\import Logic.Unique
\import Set
\import Homotopy.Join
\import Equiv
\import Equiv.Sigma
\import Equiv.Univalence
\import Homotopy.Pushout
\import SymmetricProducts.SP3
\import Utilities.Equiv
\import Utilities.Fin
\import Utilities.PathFun
\import Utilities.Paths
\import Utilities.Pushout
\import Experiments.SP3.Utils
\import Experiments.SP3.SpaceT
\import Experiments.SP3.SpaceR
\import Experiments.SP3.Collision

-- Join of two propositions is a proposition (the `isProp`-argument form of `Join.levelProp`).
\lemma joinPropIsProp {A B : \Type} (pa : isProp A) (pb : isProp B) : isProp (Join A B) =>
  isContr'=>isProp {Join A B} (\case \elim __ \with {
    | pinl a => transport (Contr __) (QEquiv-to-= (Join-sym B A)) (Join_Contr B (isProp=>isContr pa a))
    | pinr b => Join_Contr A (isProp=>isContr pb b)
  })

-- `joinEqLeft` with the right factor given as `isProp B` rather than `B : \Prop`.
\func joinEqLeftP {A B : \Type} (bP : isProp B) (ca : A)
                  (pa : \Pi (a : A) -> pinl ca = {Join A B} pinl a) : Contr (Join A B) \cowith
  | center => pinl ca
  | contraction => \case \elim __ \with {
    | pinl b => pa b
    | pinr c => path (pglue (ca, c))
    | pglue a i => joinEqLeftP.glueEqP bP ca pa a i
  } \where {
  \func glueEqP {A B : \Type} (bP : isProp B) (ca : A)
                (pa : \Pi (a : A) -> pinl ca = {Join A B} pinl a) (a : \Sigma A B)
    : Path (\lam i => pinl ca = pglue a i) (pa a.1) (path (pglue (ca, a.2))) => run {
    pathOver,
    isProp.=>isSet (isContr=>isProp (Join_Contr A (isProp=>isContr bP a.2))) _ _ _ _
  }
}

-- This file is a generalization of the proof in the file SP2OfSet.ard
-- to SP3. We try to use the same notation
--
-- The code `Qhat` below is defined by recursion on BOTH pushouts of
-- SP3 A = (S^3_2(A)) \cup_{C \times A} A,  S^3_2(A) = (A^3//S_3) \cup_{A21} (A \times A),
-- and its join's left factor at a Borel point is the BOREL path type  w0 = bv.
--
-- It is essential that the left factor is the Borel path type and not `y0 = s`:
-- a code for the path type of the FIRST pushout alone cannot exist. Indeed, for
-- A = 1 the fibers of any such propositional-join code are contractible, so its
-- total space is S^3_2(1), which is `SP3.subspaceBS2 = B\Sigma_3 \cup_{B\Sigma_2} 1`
-- (this is `SP3ContrIsContr.equivDiag`), and that space is NOT contractible:
-- it is simply connected with H_3 = Z/3, so pi_3 = Z/3 by Hurewicz. Hence the
-- encode-decode has to be run once, over the whole of SP3 A, which is what
-- `Qhat` does. (The abandoned attempt lived in `SpaceS.ard`.)

\sfunc sp3LoopSpaceContr (A : \Set \lp) (x0 x1 x2 : A) : Contr (z0 = z0) => rewrite z0Pathchar contrQz0 \where {
  \func hUT : \Type (\suc \lp) => borelXn 3 A
  \func iUT : \Type (\suc \lp) => SP3.step {A}
  \func gUT : \Type (\suc \lp) => SP3 A
  \func C : \Type (\suc \lp) => SP3.subspaceBS2
  -- the binary-collision parameter space, the domain of `SP3.fatdiag`
  \func A21 : \Type (\suc \lp) => \Sigma (b : BSn 2) (x y : A)

  \func w0 : hUT => (BSnbase 3, recFin3 {\lam _ => A} x0 x1 x2)
  \func y0 : iUT => pinl w0
  \func z0 : gUT => pinl y0

  \func P : \Prop => \Sigma (x0 = x1) (x1 = x2)

  -- The collision vocabulary of `Collision.ard`, specialized to the ambient parameters.
  \func collision (x y : A) : hUT => Col.collision {A} x y
  \func colAt (c : \Sigma A A) : \Prop => Col.colAt {A} {x0} {x1} {x2} c
  \func colBoth (bv : hUT) : \Prop => Col.colBoth {A} {x0} {x1} {x2} bv
  \func fatToCol (a : A21) : TruncP (SP3.fatdiag a = collision a.2 a.3) => Col.fatToCol {A} a
  \func colDetect (a : A21) (p : w0 = SP3.fatdiag a) : colAt (a.2, a.3) =>
    Col.colDetect {A} {x0} {x1} {x2} a p
  \func diagonalPinl (b : BSn 3) (x : A) (p : w0 = (b, \lam _ => x)) : \Sigma P (x = x0) =>
    Col.diagonalPinl {A} {x0} {x1} {x2} b x p
  \func diagonalPinr (x : A) (p : w0 = collision x x) : \Sigma P (x = x0) =>
    Col.diagonalPinr {A} {x0} {x1} {x2} x p

  -- ==========================================================================
  -- The total-diagonal certificate `T` (from SpaceT.ard) and its bookkeeping.
  -- ==========================================================================
  \func TisPropAt (x : A) (s : iUT) : isProp (T {A} {x} s) \elim s
    | pinl b => \lam _ _ => set-pi
    | pinr c => prop-isProp
  \func TisProp (s : iUT) : isProp (T {A} {x0} s) => TisPropAt x0 s

  \func diagT (a : \Sigma C A) (_ : a.2 = x0) : T {A} {x0} (SP3.diag a)
    | (pinl b, x), ax => ext (\lam _ => ax)
    | (pinr (), x), ax => (ax, ax)
    | (pglue b i, x), ax =>
      pathOver
        {\lam i => T {A} {x0} (SP3.diag (pglue b i, x))}
        {ext (\lam _ => ax)}
        {ax, ax}
        (TisProp (SP3.diag (pinr (), x)) _ (ax, ax)) @ i
  \func diagTToEq (a : \Sigma C A) (_ : T {A} {x0} (SP3.diag a)) : a.2 = x0
    | (pinl b, x), t => TruncP.rec prop-isProp (eltBSn b) (\lam y => pmap (__ y) t)
    | (pinr (), x), t => t.1

  -- ==========================================================================
  -- The code.  `J bv` is the propositional right factor at a Borel point:
  -- "w0 and bv are the same collision, or (P holds and bv is totally diagonal)".
  -- ==========================================================================
  \func J (bv : hUT) : \oo-Type (\suc \lp) => Join (colBoth bv) (\Sigma P (T {A} {x0} (pinl bv)))

  \lemma JisProp (bv : hUT) : isProp (J bv) =>
    joinPropIsProp prop-isProp (\lam _ _ => SigmaPath prop-pi (TisProp (pinl bv) _ _))

  \lemma colCodeIsProp (c : \Sigma A A) : isProp (Join (colAt c) (\Sigma P (T {A} {x0} (pinr c)))) =>
    joinPropIsProp prop-isProp (\lam _ _ => SigmaPath prop-pi (TisProp (pinr c) _ _))

  \func Ehat (s : iUT) : \oo-Type (\suc \lp) \elim s
    | pinl bv => Join (w0 = bv) (J bv)
    | pinr c => Join (colAt c) (\Sigma P (T {A} {x0} (pinr c)))
    | pglue a i => innerGlue a i \where {

    -- A Borel path to a collision point already inhabits the right factor.
    \func pathToJ (a : A21) (p : w0 = SP3.fatdiag a) : J (SP3.fatdiag a) =>
      pinl (TruncP.map (fatToCol a) (\lam fc => (a.2, a.3, (p *> fc, fc))))

    -- Hence any inhabitant of the code at a collision point inhabits the right
    -- factor, and the code there is contractible (`condCtr`).
    \func jToJ (a : A21) (j : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a))) : J (SP3.fatdiag a) \elim j
      | pinl p => pathToJ a p
      | pinr q => q
      | pglue (p, q) i => JisProp (SP3.fatdiag a) (pathToJ a p) q i

    \func condCtr (a : A21) (j : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a)))
      : Contr (Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a))) =>
      Join_Contr (w0 = SP3.fatdiag a) (isProp=>isContr (JisProp (SP3.fatdiag a)) (jToJ a j))

    -- The two collision certificates translate into each other, by composing through
    -- `fatdiag a` (so the collision values are never compared directly).
    \func toColAt (a : A21) (cb : colBoth (SP3.fatdiag a)) : colAt (a.2, a.3) =>
      TruncP.rec prop-isProp cb
          (\lam s => TruncP.map (fatToCol a) (\lam fc => s.3.1 *> inv s.3.2 *> fc))

    \func fromColAt (a : A21) (ca : colAt (a.2, a.3)) : colBoth (SP3.fatdiag a) =>
      TruncP.rec {_} {colBoth (SP3.fatdiag a)} prop-isProp ca
          (\lam wc => TruncP.map (fatToCol a) (\lam fc => (a.2, a.3, (wc, fc))))

    -- ... and so do the total-diagonal certificates, by transport along the glue.
    \func tGlue (a : A21) (t : T {A} {x0} (pinl (SP3.fatdiag a))) : T {A} {x0} (pinr (a.2, a.3)) =>
      transport (T {A} {x0}) (PushoutData.ppglue a) t
    \func tGlueInv (a : A21) (t : T {A} {x0} (pinr (a.2, a.3))) : T {A} {x0} (pinl (SP3.fatdiag a)) =>
      transport (T {A} {x0}) (inv (PushoutData.ppglue a)) t

    \func fwdJ (a : A21) (q : J (SP3.fatdiag a))
      : Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))) \elim q
      | pinl cb => pinl (toColAt a cb)
      | pinr pt => pinr (pt.1, tGlue a pt.2)
      | pglue (cb, pt) i => colCodeIsProp (a.2, a.3) (pinl (toColAt a cb)) (pinr (pt.1, tGlue a pt.2)) i

    \func fwd (a : A21) (j : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a)))
      : Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))) \elim j
      | pinl p => pinl (colDetect a p)
      | pinr q => fwdJ a q
      | pglue (p, q) i =>
        colCodeIsProp (a.2, a.3) (pinl (colDetect a p)) (fwdJ a q) i

    -- Backwards we never produce a Borel path (that would need eliminating a
    -- truncation into a non-proposition): we land in the right factor instead.
    \func bwd (a : A21) (q : Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))))
      : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a)) \elim q
      | pinl ca => pinr (pinl (fromColAt a ca))
      | pinr pt => pinr (pinr (pt.1, tGlueInv a pt.2))
      | pglue (ca, pt) i => condCtrToProp (condCtr a)
          (pinr (pinl (fromColAt a ca))) (pinr (pinr (pt.1, tGlueInv a pt.2))) i

    \func innerGlue (a : A21)
      : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a))
      = Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))) =>
      propExtEx (condCtrToProp (condCtr a)) (colCodeIsProp (a.2, a.3)) (fwd a) (bwd a)
  }

  \func Qhat (_ : gUT) : \oo-Type (\suc \lp)
    | pinl s => Ehat s
    | pinr x => \Sigma P (x = x0)
    | pglue a i => outerGlue a i \where {

    -- Reading the code at a diagonal point. The target is a proposition, so only the
    -- point constructors of C (and of the joins) need to be treated.
    \func diagToEq (a : \Sigma C A) (e : Ehat (SP3.diag a)) : \Sigma P (a.2 = x0) \elim a
      | (pinl b, x) => \case \elim e \with {
        | pinl p => diagonalPinl b x p
        | pinr q => \case \elim q \with {
          | pinl cb => TruncP.rec prop-isProp cb
              (\lam s => diagonalPinl b x (s.3.1 *> inv s.3.2))
          | pinr pt => (pt.1, diagTToEq (pinl b, x) pt.2)
        }
      }
      | (pinr (), x) => \case \elim e \with {
        | pinl ca => TruncP.rec prop-isProp ca (\lam w => diagonalPinr x w)
        | pinr pt => (pt.1, diagTToEq (pinr (), x) pt.2)
      }

    -- Conversely the certificate makes the code at a diagonal point contractible.
    -- `Contr` is a proposition, so the glue case of C is automatic.
    \func diagCtrL (b : BSn 3) (x : A) (pe : \Sigma P (x = x0)) : Contr (Ehat (pinl (b, \lam _ => x))) =>
      Join_Contr (w0 = (b, \lam _ => x))
          (isProp=>isContr (JisProp (b, \lam _ => x)) (pinr (pe.1, diagT (pinl b, x) pe.2)))
    \func diagCtrR (x : A) (pe : \Sigma P (x = x0)) : Contr (Ehat (pinr (x, x))) =>
      isProp=>isContr (colCodeIsProp (x, x)) (pinr (pe.1, diagT (pinr (), x) pe.2))

    \func diagCtr (a : \Sigma C A) (pe : \Sigma P (a.2 = x0)) : Contr (Ehat (SP3.diag a)) \elim a
      | (pinl b, x) => diagCtrL b x pe
      | (pinr (), x) => diagCtrR x pe

    \func outerGlue (a : \Sigma C A) : Ehat (SP3.diag a) = (\Sigma P (a.2 = x0)) =>
      propExtEx (condCtrToProp (\lam e => diagCtr a (diagToEq a e))) prop-isProp
          (diagToEq a) (\lam pe => (diagCtr a pe).center)
  }

  -- ==========================================================================
  -- The fiber of the code at the basepoint is contractible.
  --
  -- Qhat z0 = Join (w0 = w0) (J w0), and every Borel loop is killed: the identity
  -- because A is a set, a transposition because it exhibits w0 as a collision, and
  -- a three-cycle because it forces P. The latter two go through the right factor.
  -- ==========================================================================
  \sfunc contrQz0 : Contr (Qhat z0) => joinEqLeftP B'isProp idp borelReduce \where {
    \func q2InvEq (q1 : BSnbase 3 = BSnbase 3)
                  (q2 : transport (\lam a => a -> A) (pmap __.1 q1) w0.2 = w0.2)
                  (i : Fin 3) : w0.2 ((fin3PathEquiv q1).ret i) = w0.2 i =>
      \let | q2' : (\lam x => w0.2 (path-fun (inv (pmap __.1 q1)) x)) = w0.2 =>
               rewrite (path-fun.transport-fun w0.2 (pmap __.1 q1)) in q2
      \in run {
      rewrite (fin3PathEquivBeta q1),
      rewriteI (path-fun.inv-p (pmap __.1 q1)),
      pmap (__ i) q2'
    }

    \func q2Eq (q1 : BSnbase 3 = BSnbase 3)
               (q2 : transport (\lam a => a -> A) (pmap __.1 q1) w0.2 = w0.2)
               (i : Fin 3) : w0.2 i = w0.2 ((fin3PathEquiv q1) i) =>
      inv (pmap w0.2 ((fin3PathEquiv q1).ret_f i)) *> q2InvEq q1 q2 ((fin3PathEquiv q1) i)

    \func cycleP (q1 : BSnbase 3 = BSnbase 3)
                 (q2 : transport (\lam a => a -> A) (pmap __.1 q1) w0.2 = w0.2)
                 (noFix : \Pi (i : Fin 3) -> fin3PathEquiv q1 i /= i) : P =>
      cases ((fin3PathEquiv q1) 0 arg addPath, (fin3PathEquiv q1) 1 arg addPath, (fin3PathEquiv q1) 2 arg addPath) \with {
        | 0, e0, 1, e1, 2, e2 => absurd (noFix 0 e0)
        | 0, e0, 2, e1, 1, e2 => absurd (noFix 0 e0)
        | 1, e0, 0, e1, 2, e2 => absurd (noFix 2 e2)
        | 2, e0, 1, e1, 0, e2 => absurd (noFix 1 e1)
        | 1, e0, 2, e1, 0, e2 => (q2Eq q1 q2 0 *> pmap w0.2 e0,
                                   q2Eq q1 q2 1 *> pmap w0.2 e1)
        | 2, e0, 0, e1, 1, e2 =>
          \let | x0=x2 => q2Eq q1 q2 0 *> pmap w0.2 e0
               | x2=x1 => q2Eq q1 q2 2 *> pmap w0.2 e2
          \in (x0=x2 *> x2=x1, inv x2=x1)
        | 0, e0, 0, e1, _, _ => absurd (fin3SameImageAbsurd fin3_0_ne_1 e0 e1)
        | 0, e0, _, _, 0, e2 => absurd (fin3SameImageAbsurd fin3_0_ne_2 e0 e2)
        | _, _, 0, e1, 0, e2 => absurd (fin3SameImageAbsurd fin3_1_ne_2 e1 e2)
        | 1, e0, 1, e1, _, _ => absurd (fin3SameImageAbsurd fin3_0_ne_1 e0 e1)
        | 1, e0, _, _, 1, e2 => absurd (fin3SameImageAbsurd fin3_0_ne_2 e0 e2)
        | _, _, 1, e1, 1, e2 => absurd (fin3SameImageAbsurd fin3_1_ne_2 e1 e2)
        | 2, e0, 2, e1, _, _ => absurd (fin3SameImageAbsurd fin3_0_ne_1 e0 e1)
        | 2, e0, _, _, 2, e2 => absurd (fin3SameImageAbsurd fin3_0_ne_2 e0 e2)
        | _, _, 2, e1, 2, e2 => absurd (fin3SameImageAbsurd fin3_1_ne_2 e1 e2)
      }

    \func Ty0FromP (p : P) : T {A} {x0} y0 => ext \case \elim __ \with {
      | 0 => idp
      | 1 => inv p.1
      | 2 => inv (p.1 *> p.2)
    }

    -- The right factor of the code at the basepoint: "w0 is a collision, or P holds".
    \func B'col : \oo-Type (\suc \lp) => J w0
    \lemma B'isProp : isProp B'col => JisProp w0

    -- A Borel transposition loop puts w0 on the collision stratum.
    \func colBothTrans (q1 : BSnbase 3 = BSnbase 3) (fixed : Fin 3)
                       (fixedPath : fin3PathEquiv q1 fixed = fixed)
                       (moved : \Pi (i : Fin 3) -> i /= fixed -> fin3PathEquiv q1 i /= i)
                       (q2 : transport (\lam a => a -> A) (pmap __.1 q1) w0.2 = w0.2)
      : colBoth w0 =>
      \let | rt => routeEq fixed
           | base_r => BSnPath (BSnbase 3) (extendBSn 1 (BSnbase 2)) rt
           | va => w0.2 (routeR fixed (inl 0))
           | vb => w0.2 (routeR fixed (inr 0))
           | fpq1 => transNF (fin3PathEquiv q1) fixed fixedPath moved
           | movedEq : w0.2 (routeR fixed (inl 1)) = w0.2 (routeR fixed (inl 0)) =>
               q2Eq q1 q2 (routeR fixed (inl 1))
                 *> pmap w0.2 (pmap (\lam (e : Equiv {Fin 3} {Fin 3}) => e (routeR fixed (inl 1))) fpq1 *> swapMovedEq fixed)
           | tupleEq : transport (\lam a => a.1 -> A) base_r w0.2 = (SP3.fatdiag (BSnbase 2, va, vb)).2 => run {
               rewrite (transportRouteTuple rt w0.2),
               ext (\case \elim __ \with { | inl 0 => idp | inl 1 => movedEq | inr 0 => idp })
             }
           | r : w0 = collision va vb => SigmaPath base_r tupleEq
      \in inP (va, vb, (r, r))

    -- A Borel three-cycle loop forces total diagonality, giving the right join factor.
    \func cycleWitness (q1 : BSnbase 3 = BSnbase 3)
                       (q2 : transport (\lam a => a -> A) (pmap __.1 q1) w0.2 = w0.2)
                       (noFix : \Pi (i : Fin 3) -> fin3PathEquiv q1 i /= i) : \Sigma P (T {A} {x0} y0) =>
      \let p => cycleP q1 q2 noFix \in (p, Ty0FromP p)

    -- If the right factor B'col is inhabited, both endpoints connect through it.
    \func brVia (b' : B'col) (loop : w0 = w0) : pinl idp = {Join (w0 = w0) B'col} pinl loop =>
      path (pglue ((idp : w0 = w0), b')) *> inv (path (pglue (loop, b')))

    -- The identity Borel loop is trivial because A is a set.
    \func brIdp (q1 : BSnbase 3 = BSnbase 3) (p : q1 = idp)
                (q2 : transport (\lam a => a -> A) (pmap __.1 q1) w0.2 = w0.2)
      : pinl idp = {Join (w0 = w0) B'col} pinl (SigmaPath q1 q2) \elim p
      | idp => run {
        rewrite (set-pi {Fin 3 -> A} {w0.2} {w0.2} {q2} {idp}),
        pmap pinl,
        idp
      }

    -- Every Borel loop maps to the basepoint in Join (w0=w0) B'col.
    \func borelReduce (h : w0 = w0) : pinl idp = {Join (w0 = w0) B'col} pinl h => run {
      rewrite (SigmaPathChar.eq h),
      \let bp => SigmaPathChar _ _ h,
      \case base3PathChar bp.1 \with {
        | fin3PermId p => brIdp bp.1 (base3PathId bp.1 p) bp.2
        | fin3PermTransposition fixed fixedPath moved =>
          brVia (pinl (colBothTrans bp.1 fixed fixedPath moved bp.2)) (SigmaPath bp.1 bp.2)
        | fin3PermCycle noFix cycle3 => brVia (pinr (cycleWitness bp.1 bp.2 noFix)) (SigmaPath bp.1 bp.2)
      }
    }
  }

  -- ==========================================================================
  -- The total space of the code.  THIS IS THE REMAINING GAP (Section 5 of
  -- SP3-Qz0-report.md); it subsumes the old `Dflat = D'` hole.
  --
  -- The staged plan, each stage imitating `SpaceR.Rchar` / `SpaceT.repr`:
  --  1. `PushoutData.flattening Qhat` presents it as a pushout with corners
  --     L := \Sigma (s : iUT) (Ehat s),  \Sigma (x : A) (\Sigma P (x = x0)) ~ P,
  --     and \Sigma ((c,x) : C \times A) (Ehat (SP3.diag (c,x))) ~ C \times P
  --     (rewrite the fiber along `outerGlue` with `pushout-equiv`, then contract
  --     `x = x0` as in `Rchar.baseR=tail`).
  --  2. `PushoutData.flattening Ehat` presents L as a pushout with corners
  --     \Sigma (bv : hUT) (Join (w0 = bv) (J bv)), \Sigma (c : \Sigma A A) (Ehat (pinr c)),
  --     \Sigma (a : A21) (Ehat (pinl (SP3.fatdiag a))).
  --  3. `pushout-sigma` + `pushout-contr (lsigma w0)` peel the honest spine
  --     \Sigma (bv) (w0 = bv) ~ 1 off the first corner.
  --  4. `pushout-sigma` splits the remaining corners; identify
  --     \Sigma (bv) (\Sigma P (T (pinl bv))) ~ P \times BSn 3 by `T.repr.left=`,
  --     \Sigma (c) (\Sigma P (T (pinr c))) ~ P by `T.repr.right=`, and
  --     \Sigma (c) (colAt c) =: ColR, a proposition by `Col.colValsDet`.
  --  5. Index the collision stratum by the proposition ColR (using `Col.colAtDiag`
  --     for its diagonal part) and flatten once more. The goal `Contr _` is then a
  --     proposition, so the truncation in ColR may be opened: assume an actual path
  --     w0 = collision x y and contract explicitly, as `contractionD` does below.
  --
  -- Stage 5 is the only genuinely new pushout engineering; stages 1-4 are mechanical.
  -- ==========================================================================
  \func contrQhat : Contr (\Sigma (z : gUT) (Qhat z)) => {?}

  \func z0Pathchar : (z0 = z0) = Qhat z0 => fundamentalIP {gUT} {z0} {z0} {Qhat} (pinl idp) contrQhat

  -- unused: the small model of the total space of the OLD code, kept as the template
  -- for the explicit contraction of stage 5 above. `D'` is a pushout of `P <- P -> C x P`
  -- and `contractionD` contracts it by pushout induction, with `RgluePath` and
  -- `DgluePath` as the two glue coherences.
  {-
  \func R' : \oo-Type (\suc \lp) => R.R' {A} {x0} {x1} {x2}

  \func D' : \oo-Type (\suc \lp) => PushoutData {\Sigma C P} {P} {R'} __.2 pinr

  \func RgluePath (p : P) : Path (\lam i => pinr (pglue p i) = {D'} pinr (pinl ())) idp
      (inv (path (pglue (pinr (), p))) *> path (pglue (pinr (), p)) *> pmap pinr (inv (path (pglue p))))
    => run {
      pathOver,
      *> (coe_path (\lam i => pinr (pglue p i)) idp idp),
      rewriteI *>-assoc,
      rewrite inv_*>,
      rewrite idp_*>,
      inv,
      pmap_inv-comm pinr (path (pglue p))
    }
  \func DgluePath (c : C) (p : P) : Path (\lam i => pglue (c, p) i = {D'} pinr (pinl ()))
      (path (pglue (pinr (), p)) *> inv (pmap pinr (path (pglue p))))
      (inv (path (pglue (c, p))) *> path (pglue (pinr (), p)) *> pmap pinr (inv (path (pglue p)))) => run {
    pathOver,
    *> (coe_path (\lam i => pglue (c, p) i) _ idp),
    pmap (inv (path (pglue (c, p))) *>),
    pmap (path (pglue (pinr (), p)) *>),
    inv,
    pmap_inv-comm pinr (path (pglue p))
  }

  \func contractionD (d : D') : d = pinr (pinl ())
    | pinl p => path (pglue (pinr (), p)) *> inv (pmap pinr (path (pglue p)))
    | pinr (pinl ()) => idp
    | pinr (pinr (c, p)) => inv (path (pglue (c, p))) *> path (pglue (pinr (), p)) *> pmap pinr (inv (path (pglue p)))
    | pinr (pglue p i) => RgluePath p i
    | pglue (c, p) i => DgluePath c p i

  \func contrD' : Contr D' \cowith
    | center => pinr (pinl ())
    | contraction a => inv (contractionD a)
  -}
}
