\import SymmetricProducts.BSn
\import SymmetricProducts.Borel
\import Data.Or
\import Data.Fin
\import Function.Meta
\import Meta
\import Paths
\import Paths.Meta
\import Logic
\import Logic.Unique
\import Set
\import Homotopy.Join
\import Equiv
\import Equiv.Sigma
\import Equiv.Univalence
\import Homotopy.Pushout
\import SymmetricProducts.SP3
\import Utilities.Equiv
\import Utilities.PathFun
\import Utilities.Paths
\import Utilities.Pushout
\import Experiments.SP3.Basepoint
\import Experiments.SP3.Collision
\import Experiments.SP3.FatPath
\import Experiments.SP3.SpaceT
\import Experiments.SP3.Utils
\import Utilities.Unit

-- This file is a generalization of the proof in the file SP2OfSet.ard
-- to SP3. We try to use the same notation.
--
-- The code `Qhat` below is defined by recursion on BOTH pushouts of
-- SP3 A = (S^3_2(A)) \cup_{C \times A} A,  S^3_2(A) = (A^3//S_3) \cup_{A21} (A \times A),
-- and its join's left factor at a Borel point is the BOREL path type  w0 = bv.
--
-- It is essential that the left factor is the Borel path type and not `y0 = s`:
-- a code for the path type of the FIRST pushout alone cannot exist. Indeed, for
-- A = 1 the fibers of any such propositional-join code are contractible, so its
-- total space is S^3_2(1), which is `SP3.subspaceBS2 = B\Sigma_3 \cup_{B\Sigma_2} 1`
-- (this is `SP3ContrIsContr.equivDiag`), and that space is NOT contractible:
-- it is simply connected with H_3 = Z/3, so pi_3 = Z/3 by Hurewicz. Hence the
-- encode-decode has to be run once, over the whole of SP3 A, which is what
-- `Qhat` does. (The abandoned attempt lived in `SpaceS.ard`.)
--
-- The two halves of the encode-decode:
--   * the fiber at the basepoint is contractible -- `Basepoint.ard`;
--   * the total space is contractible -- the staged reduction at the end of this
--     file, whose last stage is the one remaining goal.

\func sp3LoopSpaceContr (A : \Set \lp) (x0 x1 x2 : A) : Contr (z0 = z0) => rewrite z0Pathchar contrQz0 \where {
  -- These are stated at a fixed homotopy level: leaving it open makes the level
  -- of everything built from them float, which the eliminations of stage 5 (in
  -- particular `ctrW.qPath`) can then no longer be checked against.
  \func hUT : \oo-Type (\suc \lp) => borelXn 3 A
  \func iUT : \oo-Type (\suc \lp) => SP3.step {A}
  \func gUT : \oo-Type (\suc \lp) => SP3 A
  \func C : \oo-Type (\suc \lp) => SP3.subspaceBS2
  -- the binary-collision parameter space, the domain of `SP3.fatdiag`
  \func A21 : \oo-Type (\suc \lp) => \Sigma (b : BSn 2) (x y : A)

  \func w0 : hUT => (BSnbase 3, recFin3 {\lam _ => A} x0 x1 x2)
  \func y0 : iUT => pinl w0
  \func z0 : gUT => pinl y0

  \func P : \Prop => \Sigma (x0 = x1) (x1 = x2)

  -- The collision and diagonal vocabulary of `Collision.ard`, specialized to the
  -- ambient parameters. `J bv` is the propositional certificate carried by the
  -- code at a Borel point: "w0 and bv are the same collision, or (P holds and bv
  -- is totally diagonal)".
  \func collision (x y : A) : hUT => Col.collision {A} x y
  \func colAt (c : \Sigma A A) : \Prop => Col.colAt {A} {x0} {x1} {x2} c
  \func colBoth (bv : hUT) : \Prop => Col.colBoth {A} {x0} {x1} {x2} bv
  \sfunc fatToCol (a : A21) : TruncP (SP3.fatdiag a = collision a.2 a.3) => Col.fatToCol {A} a
  \sfunc colDetect (a : A21) (p : w0 = SP3.fatdiag a) : colAt (a.2, a.3) =>
    Col.colDetect {A} {x0} {x1} {x2} a p
  \sfunc diagonalPinl (b : BSn 3) (x : A) (p : w0 = (b, \lam _ => x)) : \Sigma P (x = x0) =>
    Col.diagonalPinl {A} {x0} {x1} {x2} b x p
  \sfunc diagonalPinr (x : A) (p : w0 = collision x x) : \Sigma P (x = x0) =>
    Col.diagonalPinr {A} {x0} {x1} {x2} x p
  \func J (bv : hUT) : \oo-Type (\suc \lp) => Col.J {A} {x0} {x1} {x2} bv
  \lemma JisProp (bv : hUT) : isProp (J bv) => Col.JisProp {A} {x0} {x1} {x2} bv

  -- Transporting the total-diagonal certificate `T` (from `SpaceT.ard`) along the
  -- outer glue of SP3, in both directions.
  \sfunc diagT (a : \Sigma C A) (_ : a.2 = x0) : T {A} {x0} (SP3.diag a)
    | (pinl b, x), ax => ext (\lam _ => ax)
    | (pinr (), x), ax => (ax, ax)
    | (pglue b i, x), ax =>
      pathOver
          {\lam i => T {A} {x0} (SP3.diag (pglue b i, x))}
              {ext (\lam _ => ax)}
          {ax, ax}
          (TisProp {A} {x0} (SP3.diag (pinr (), x)) _ (ax, ax)) @ i
  \sfunc diagTToEq (a : \Sigma C A) (_ : T {A} {x0} (SP3.diag a)) : a.2 = x0
    | (pinl b, x), t => TruncP.rec prop-isProp (eltBSn b) (\lam y => pmap (__ y) t)
    | (pinr (), x), t => t.1

  \lemma colCodeIsProp (c : \Sigma A A) : isProp (Join (colAt c) (\Sigma P (T {A} {x0} (pinr c)))) =>
    joinPropIsProp prop-isProp (\lam _ _ => SigmaPath prop-pi (TisProp {A} {x0} (pinr c) _ _))

  -- ==========================================================================
  -- The code.
  -- ==========================================================================
  \func Ehat (s : iUT) : \oo-Type (\suc \lp) \elim s
    | pinl bv => Join (w0 = bv) (J bv)
    | pinr c => Join (colAt c) (\Sigma P (T {A} {x0} (pinr c)))
    | pglue a i => innerGlue a i \where {

    -- A Borel path to a collision point already inhabits the right factor.
    \sfunc pathToJ (a : A21) (p : w0 = SP3.fatdiag a) : J (SP3.fatdiag a) =>
      pinl (TruncP.map (fatToCol a) (\lam fc => (a.2, a.3, (p *> fc, fc))))

    -- Hence any inhabitant of the code at a collision point inhabits the right
    -- factor, and the code there is contractible (`condCtr`).
    \sfunc jToJ (a : A21) (j : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a))) : J (SP3.fatdiag a) \elim j
      | pinl p => pathToJ a p
      | pinr q => q
      | pglue (p, q) i => JisProp (SP3.fatdiag a) (pathToJ a p) q i

    \sfunc condCtr (a : A21) (j : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a)))
      : Contr (Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a))) =>
      Join_Contr (w0 = SP3.fatdiag a) (isProp=>isContr (JisProp (SP3.fatdiag a)) (jToJ a j))

    -- The two collision certificates translate into each other, by composing through
    -- `fatdiag a` (so the collision values are never compared directly).
    \lemma toColAt (a : A21) (cb : colBoth (SP3.fatdiag a)) : colAt (a.2, a.3) =>
      TruncP.rec prop-isProp cb
          (\lam s => TruncP.map (fatToCol a) (\lam fc => s.3.1 *> inv s.3.2 *> fc))

    \lemma fromColAt (a : A21) (ca : colAt (a.2, a.3)) : colBoth (SP3.fatdiag a) =>
      TruncP.rec {_} {colBoth (SP3.fatdiag a)} prop-isProp ca
          (\lam wc => TruncP.map (fatToCol a) (\lam fc => (a.2, a.3, (wc, fc))))

    -- ... and so do the total-diagonal certificates, by transport along the glue.
    \sfunc tGlue (a : A21) (t : T {A} {x0} (pinl (SP3.fatdiag a))) : T {A} {x0} (pinr (a.2, a.3)) =>
      transport (T {A} {x0}) (PushoutData.ppglue a) t
    \sfunc tGlueInv (a : A21) (t : T {A} {x0} (pinr (a.2, a.3))) : T {A} {x0} (pinl (SP3.fatdiag a)) =>
      transport (T {A} {x0}) (inv (PushoutData.ppglue a)) t

    \func fwdJ (a : A21) (q : J (SP3.fatdiag a))
      : Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))) \elim q
      | pinl cb => pinl (toColAt a cb)
      | pinr pt => pinr (pt.1, tGlue a pt.2)
      | pglue (cb, pt) i => colCodeIsProp (a.2, a.3) (pinl (toColAt a cb)) (pinr (pt.1, tGlue a pt.2)) i

    \func fwd (a : A21) (j : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a)))
      : Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))) \elim j
      | pinl p => pinl (colDetect a p)
      | pinr q => fwdJ a q
      | pglue (p, q) i =>
        colCodeIsProp (a.2, a.3) (pinl (colDetect a p)) (fwdJ a q) i

    -- Backwards we never produce a Borel path (that would need eliminating a
    -- truncation into a non-proposition): we land in the right factor instead.
    \func bwd (a : A21) (q : Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))))
      : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a)) \elim q
      | pinl ca => pinr (pinl (fromColAt a ca))
      | pinr pt => pinr (pinr (pt.1, tGlueInv a pt.2))
      | pglue (ca, pt) i => condCtrToProp (condCtr a)
          (pinr (pinl (fromColAt a ca))) (pinr (pinr (pt.1, tGlueInv a pt.2))) i

    \func innerGlue (a : A21)
      : Join (w0 = SP3.fatdiag a) (J (SP3.fatdiag a))
      = Join (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))) =>
      propExtEx (condCtrToProp (condCtr a)) (colCodeIsProp (a.2, a.3)) (fwd a) (bwd a)
  }

  \func Qhat (_ : gUT) : \oo-Type (\suc \lp)
    | pinl s => Ehat s
    | pinr x => \Sigma P (x = x0)
    | pglue a i => outerGlue a i \where {

    -- Reading the code at a diagonal point. The target is a proposition, so only the
    -- point constructors of C (and of the joins) need to be treated.
    \sfunc diagToEq (a : \Sigma C A) (e : Ehat (SP3.diag a)) : \Sigma P (a.2 = x0) \elim a
      | (pinl b, x) => \case \elim e \with {
        | pinl p => diagonalPinl b x p
        | pinr q => \case \elim q \with {
          | pinl cb => TruncP.rec prop-isProp cb
              (\lam s => diagonalPinl b x (s.3.1 *> inv s.3.2))
          | pinr pt => (pt.1, diagTToEq (pinl b, x) pt.2)
        }
      }
      | (pinr (), x) => \case \elim e \with {
        | pinl ca => TruncP.rec prop-isProp ca (\lam w => diagonalPinr x w)
        | pinr pt => (pt.1, diagTToEq (pinr (), x) pt.2)
      }

    -- Conversely the certificate makes the code at a diagonal point contractible.
    -- `Contr` is a proposition, so the glue case of C is automatic.
    \sfunc diagCtrL (b : BSn 3) (x : A) (pe : \Sigma P (x = x0)) : Contr (Ehat (pinl (b, \lam _ => x))) =>
      Join_Contr (w0 = (b, \lam _ => x))
          (isProp=>isContr (JisProp (b, \lam _ => x)) (pinr (pe.1, diagT (pinl b, x) pe.2)))
    \sfunc diagCtrR (x : A) (pe : \Sigma P (x = x0)) : Contr (Ehat (pinr (x, x))) =>
      isProp=>isContr (colCodeIsProp (x, x)) (pinr (pe.1, diagT (pinr (), x) pe.2))

    \sfunc diagCtr (a : \Sigma C A) (pe : \Sigma P (a.2 = x0)) : Contr (Ehat (SP3.diag a)) \elim a
      | (pinl b, x) => diagCtrL b x pe
      | (pinr (), x) => diagCtrR x pe

    \func outerGlue (a : \Sigma C A) : Ehat (SP3.diag a) = (\Sigma P (a.2 = x0)) =>
      propExtEx (condCtrToProp (\lam e => diagCtr a (diagToEq a e))) prop-isProp
          (diagToEq a) (\lam pe => (diagCtr a pe).center)
  }

  -- ==========================================================================
  -- Half one of the encode-decode: the fiber at the basepoint. `Qhat z0` computes
  -- to `Join (w0 = w0) (J w0)`, which is `Basepoint.Qz0`.
  -- ==========================================================================
  \sfunc contrQz0 : Contr (Qhat z0) => Qz0.contr {A} {x0} {x1} {x2}

  \sfunc z0Pathchar : (z0 = z0) = Qhat z0 => fundamentalIP {gUT} {z0} {z0} {Qhat} (pinl idp) contrQhat

  -- ==========================================================================
  -- Half two: the total space of the code (Section 5 of SP3-Qz0-report.md), by
  -- the stages of the report.
  --
  --   1. flatten the OUTER pushout and simplify its base and right corners:
  --      the total space becomes  Qsmall = P <- C x P -> L,  where L is the
  --      total space of the code over the inner pushout SP3.step;
  --   2. flatten the INNER pushout: L becomes  Rho <- Bfat -> Lam;
  --   3. peel the contractible honest spine off the Borel corner Lam;
  --   4. split the three corners into their collision and diagonal strata and
  --      identify those;
  --   5. contract what is left.
  --
  -- Stages 1-4 are done: the total space is `QsmallSplit`, and stage 5 -- the
  -- goal `contrQsmallSplit` -- is all that remains.
  -- ==========================================================================

  -- The total space of the code over the inner pushout.
  \func L : \oo-Type (\suc \lp) => \Sigma (s : iUT) (Ehat s)

  -- --------------------------------------------------------------------------
  -- Stage 1: the outer flattening.
  -- --------------------------------------------------------------------------
  \func Qflat : \oo-Type (\suc \lp) => PushoutData
      {\Sigma (a : \Sigma C A) (Ehat (SP3.diag a))}
      {L}
      {\Sigma (x : A) (\Sigma P (x = x0))}
      (\lam p => (SP3.diag p.1, p.2))
      (\lam p => (p.1.2, transport Qhat (PushoutData.ppglue p.1) p.2))

  \sfunc Qflat=Q : Qflat = (\Sigma (z : gUT) (Qhat z)) => PushoutData.flattening Qhat

  -- The right corner is P: the fiber `x = x0` is contractible.
  \lemma rightCornerIsProp : isProp (\Sigma (x : A) (\Sigma P (x = x0))) =>
    \lam u v => SigmaPropPath {A} {\lam (x : A) => \Sigma P (x = x0)} (\lam _ => prop-isProp) (u.2.2 *> inv v.2.2)

  \sfunc rightCorner= : (\Sigma (x : A) (\Sigma P (x = x0))) = P => iso f g sec ret \where {
    \sfunc f (u : \Sigma (x : A) (\Sigma P (x = x0))) : P => u.2.1
    \sfunc g (p : P) : \Sigma (x : A) (\Sigma P (x = x0)) => (x0, (p, idp))
    \sfunc sec (u : \Sigma (x : A) (\Sigma P (x = x0))) : g (f u) = u => rightCornerIsProp _ _
    \lemma ret (p : P) : f (g p) = p => prop-pi
  }

  -- The base corner is C x P: at a diagonal point the code IS the certificate
  -- (that is `outerGlue`, here in the `iso` form that computes under `path-fun`).
  \func baseCorner= : (\Sigma (a : \Sigma C A) (Ehat (SP3.diag a))) = (\Sigma C P) =>
    iso f g sec ret \where {
    \func f (u : \Sigma (a : \Sigma C A) (Ehat (SP3.diag a))) : \Sigma C P =>
      (u.1.1, (Qhat.diagToEq u.1 u.2).1)
    \func g (cp : \Sigma C P) : \Sigma (a : \Sigma C A) (Ehat (SP3.diag a)) =>
      ((cp.1, x0), (Qhat.diagCtr (cp.1, x0) (cp.2, idp)).center)
    \sfunc sec (u : \Sigma (a : \Sigma C A) (Ehat (SP3.diag a))) : g (f u) = u =>
      SigmaPath (ext (idp, inv (Qhat.diagToEq u.1 u.2).2))
          (isContr=>isProp (Qhat.diagCtr u.1 (Qhat.diagToEq u.1 u.2)) _ _)
    \sfunc ret (cp : \Sigma C P) : f (g cp) = cp => SigmaPropPath {C} {\lam _ => P} (\lam _ => prop-isProp) idp
  }

  -- The base-to-left map of the small model: the canonical diagonal point of L.
  \func diagPoint (cp : \Sigma C P) : L =>
    (SP3.diag (cp.1, x0), (Qhat.diagCtr (cp.1, x0) (cp.2, idp)).center)

  \func Qsmall : \oo-Type (\suc \lp) => PushoutData {\Sigma C P} {L} {P} diagPoint __.2

  \sfunc Qflat=Qsmall : Qflat = Qsmall =>
    pushout-equiv baseCorner= (idp : L = L) rightCorner= _ _
      *> pushout-eqv-fun _ _ _ _ leftFun rightFun \where {
    \sfunc leftFun :
      (\lam cp => path-fun (idp : L = L)
          (\let p => path-fun (inv baseCorner=) cp \in (SP3.diag p.1, p.2))) = diagPoint => run {
      unfold baseCorner=,
      rewrite (path-fun.beta-inv baseCorner=.f baseCorner=.g baseCorner=.sec baseCorner=.ret),
      idp
    }
    -- Both sides land in the proposition P.
    \sfunc rightFun :
      (\lam cp => path-fun rightCorner=
          (\let p => path-fun (inv baseCorner=) cp \in (p.1.2, transport Qhat (PushoutData.ppglue p.1) p.2)))
        = (\lam (cp : \Sigma C P) => cp.2) => ext
  }

  -- --------------------------------------------------------------------------
  -- Stage 2: the inner flattening of L.
  -- --------------------------------------------------------------------------
  \func Bfat : \oo-Type (\suc \lp) => \Sigma (a : A21) (Ehat (pinl (SP3.fatdiag a)))
  \func Lam : \oo-Type (\suc \lp) => \Sigma (bv : hUT) (Ehat (pinl bv))
  \func Rho : \oo-Type (\suc \lp) => \Sigma (c : \Sigma A A) (Ehat (pinr c))

  \func lfat (p : Bfat) : Lam => (SP3.fatdiag p.1, p.2)
  \func rfat (p : Bfat) : Rho => ((p.1.2, p.1.3), transport Ehat (PushoutData.ppglue p.1) p.2)

  \func Lflat : \oo-Type (\suc \lp) => PushoutData {Bfat} {Lam} {Rho} lfat rfat

  \sfunc Lflat=L : Lflat = L => PushoutData.flattening Ehat

  -- --------------------------------------------------------------------------
  -- Stage 3: the Borel corner is a cone. Its honest spine `\Sigma (bv) (w0 = bv)`
  -- is contractible, so it collapses to a point, leaving a cone on the stratum
  -- `\Sigma (bv) (J bv)` of certificates.
  -- --------------------------------------------------------------------------
  \func Spine : \oo-Type (\suc \lp) => \Sigma (bv : hUT) (\Sigma (w0 = bv) (J bv))

  \func leftSum : \oo-Type (\suc \lp) => PushoutData
      {Spine} {\Sigma (bv : hUT) (w0 = bv)} {\Sigma (bv : hUT) (J bv)}
      (\lam b => (b.1, b.2.1)) (\lam b => (b.1, b.2.2))

  \sfunc left=leftSum : Lam = leftSum => pushout-sigma _ _

  -- The certificate stratum of the Borel corner, under the sum/pushout exchange.
  -- (Stated here so that `pushout-sigma`'s implicit legs are fixed by the signature.)
  \sfunc leftSumBetaPinr (bv : hUT) (j : J bv) : path-fun left=leftSum (bv, pinr j) = pinr (bv, j) =>
    rewrite (\peval left=leftSum) (pushout-sigma.beta-pinr {hUT}
        {\lam bv' => \Sigma (w0 = bv') (J bv')} {\lam bv' => w0 = bv'} {J}
        {\lam _ u => u.1} {\lam _ u => u.2} bv j)

  \func leftCtr : \oo-Type (\suc \lp) => PushoutData
      {Spine} {\Sigma} {\Sigma (bv : hUT) (J bv)}
      (\lam _ => ()) (\lam b => (b.1, b.2.2))

  \sfunc leftSum=leftCtr : leftSum = leftCtr => pushout-contr (lsigma w0) _ _

  \sfunc leftCtrBetaPinr (u : \Sigma (bv : hUT) (J bv)) : path-fun leftSum=leftCtr (pinr u) = pinr u =>
    rewrite (\peval leftSum=leftCtr) (pushout-contr.beta-pinr {Spine}
        {\Sigma (bv : hUT) (w0 = bv)} {\Sigma (bv : hUT) (J bv)}
        {lsigma w0} {\lam (b : Spine) => (b.1, b.2.1)} {\lam (b : Spine) => (b.1, b.2.2)} u)

  -- --------------------------------------------------------------------------
  -- Stage 4: split the three corners into their collision and diagonal strata.
  -- --------------------------------------------------------------------------
  -- The strata of the Borel side: `ColB` is the collision stratum, `Dl` the
  -- diagonal one, which is `P x BSn 3` by the `left=` corner of `T.repr`.
  \func ColB : \oo-Type (\suc \lp) => \Sigma (bv : hUT) (colBoth bv)
  \func Dl : \oo-Type (\suc \lp) => \Sigma (bv : hUT) (\Sigma P (T {A} {x0} (pinl bv)))
  \func JOverlap : \oo-Type (\suc \lp) =>
    \Sigma (bv : hUT) (\Sigma (colBoth bv) (\Sigma P (T {A} {x0} (pinl bv))))

  \func jCol (b : JOverlap) : ColB => (b.1, b.2.1)
  \func jDl (b : JOverlap) : Dl => (b.1, b.2.2)

  \func JSplit : \oo-Type (\suc \lp) => PushoutData {JOverlap} {ColB} {Dl} jCol jDl

  \sfunc JSum= : (\Sigma (bv : hUT) (J bv)) = JSplit => pushout-sigma _ _

  \sfunc jSumBetaPinl (bv : hUT) (cb : colBoth bv) : path-fun JSum= (bv, pinl cb) = pinl (bv, cb) =>
    rewrite (\peval JSum=) (pushout-sigma.beta-pinl {hUT}
        {\lam bv' => \Sigma (colBoth bv') (\Sigma P (T {A} {x0} (pinl bv')))}
        {colBoth} {\lam bv' => \Sigma P (T {A} {x0} (pinl bv'))}
        {\lam _ u => u.1} {\lam _ u => u.2} bv cb)

  \func Delta= : Dl = (\Sigma P (BSn 3)) =>
    DeltaRegroup *> pmap (\lam (X : \Type (\suc \lp)) => \Sigma P X) (T.repr.left= {A} {x0}) \where {
    \func DeltaRegroup : Dl = (\Sigma P (T.repr.leftT {A} {x0})) => iso to fro (\lam _ => idp) (\lam _ => idp)
    \func to (u : Dl) : \Sigma P (T.repr.leftT {A} {x0}) => (u.2.1, (u.1, u.2.2))
    \func fro (u : \Sigma P (T.repr.leftT {A} {x0})) : Dl => (u.2.1, (u.1, u.2.2))
  }

  -- The value of the diagonal identification: it forgets the certificate and keeps
  -- the underlying BSn 3 point. (First of the map computations of stage 5; the
  -- corresponding one for `rightT=` is `betaRightT` below, free because P is a prop.)
  \sfunc betaDelta (u : Dl) : path-fun Delta= u = (u.2.1, u.1.1) => run {
    unfold Delta=,
    rewrite (path-fun.beta-*> Delta=.DeltaRegroup
        (pmap (\lam (X : \Type (\suc \lp)) => \Sigma P X) (T.repr.left= {A} {x0}))),
    unfold Delta=.DeltaRegroup,
    rewrite (path-fun.beta Delta=.to Delta=.fro (\lam _ => idp) (\lam _ => idp)),
    rewrite (pathFunSigmaR (T.repr.left= {A} {x0}) (Delta=.to u)),
    unfold T.repr.left=,
    rewrite (path-fun.beta T.repr.left=.f T.repr.left=.g T.repr.left=.sec (T.repr.left=.ret {A} {x0})),
    idp
  }

  \lemma betaRightT (u : Dr) : path-fun rightT= u = u.2.1 => prop-pi

  -- The Borel-side splitting with its diagonal leg computed by `betaDelta`: the
  -- overlap of the two strata sits over `BSn 3` by its own base point.
  \func JSplitD : \oo-Type (\suc \lp) => PushoutData
      {JOverlap} {ColB} {\Sigma P (BSn 3)} jCol (\lam b => (b.2.2.1, b.1.1))

  \sfunc JSum=D : (\Sigma (bv : hUT) (J bv)) = JSplitD =>
    JSum= *> pushout-equiv idp idp Delta= jCol jDl
               *> pushout-eqv-fun _ _ _ _ idp (ext (\lam b => betaDelta (jDl b)))

  -- The Borel corner, fully split.
  \func LeftCone : \oo-Type (\suc \lp) => PushoutData
      {Spine} {\Sigma} {JSplitD}
      (\lam _ => ()) (\lam b => path-fun JSum=D (b.1, b.2.2))

  \sfunc left= : Lam = LeftCone =>
    left=leftSum *> leftSum=leftCtr
                      *> pushout-equiv idp idp JSum=D (\lam (_ : Spine) => ()) (\lam (b : Spine) => (b.1, b.2.2))

  -- The strata of the collision side: `ColR` is the collision stratum -- a
  -- proposition, since two collision presentations of w0 have equal values --
  -- and `Dr` the diagonal one, which is P by the `right=` corner of `T.repr`.
  \func ColR : \oo-Type \lp => \Sigma (c : \Sigma A A) (colAt c)
  \func Dr : \oo-Type \lp => \Sigma (c : \Sigma A A) (\Sigma P (T {A} {x0} (pinr c)))
  \func ROverlap : \oo-Type \lp =>
    \Sigma (c : \Sigma A A) (\Sigma (colAt c) (\Sigma P (T {A} {x0} (pinr c))))

  \lemma ColRisProp : isProp ColR =>
    \lam u v => SigmaPropPath {\Sigma A A} {\lam c => colAt c} (\lam _ => prop-isProp) (valsEq u v) \where {
    \lemma valsEq (u v : ColR) : u.1 = v.1 =>
      TruncP.rec prop-isProp u.2 (\lam wu => TruncP.rec prop-isProp v.2
          (\lam wv => ext (Col.colValsDet {A} (inv wu *> wv))))
  }

  \func rCol (b : ROverlap) : ColR => (b.1, b.2.1)
  \func rDr (b : ROverlap) : Dr => (b.1, b.2.2)

  \func rightSplit : \oo-Type (\suc \lp) => PushoutData {ROverlap} {ColR} {Dr} rCol rDr

  \sfunc rightSum= : Rho = rightSplit => pushout-sigma _ _

  \sfunc rightT= : Dr = P =>
    rightTRegroup *> pmap (\lam (X : \Type \lp) => \Sigma P X) (T.repr.right= {A} {x0}) *> unitRight \where {
    \sfunc rightTRegroup : Dr = (\Sigma P (T.repr.rightT {A} {x0})) => iso to fro (\lam _ => idp) (\lam _ => idp)
    \func to (u : Dr) : \Sigma P (T.repr.rightT {A} {x0}) => (u.2.1, (u.1, u.2.2))
    \func fro (u : \Sigma P (T.repr.rightT {A} {x0})) : Dr => (u.2.1, (u.1, u.2.2))
    \sfunc unitRight : (\Sigma P (\Sigma)) = P =>
      iso (\lam u => u.1) (\lam p => (p, ())) (\lam _ => idp) (\lam _ => idp)
  }

  -- The collision corner, fully split, with its diagonal leg computed by `betaRightT`.
  \func RightSplitP : \oo-Type (\suc \lp) => PushoutData
      {ROverlap} {ColR} {P} rCol (\lam b => b.2.2.1)

  \sfunc right= : Rho = RightSplitP =>
    rightSum= *> pushout-equiv idp idp rightT= rCol rDr
                   *> pushout-eqv-fun _ _ _ _ idp (ext (\lam b => betaRightT (rDr b)))

  -- Section 4 of SP3-stage5-report.md: the collision corner is a proposition, and
  -- it is logically equivalent to the certificate `J w0` at the basepoint. Both
  -- facts are used by the contraction (stage 5).
  --
  -- Every point of the code at a collision point carries the collision certificate:
  -- either directly, or because the diagonal certificate pins the values to x0 and
  -- then P makes w0 the diagonal collision (`Col.w0Diag`).
  \sfunc cIsDiag (c : \Sigma A A) (t : T {A} {x0} (pinr c)) : c = (x0, x0) => ext (t.1, t.2)

  \sfunc rhoColAt (c : \Sigma A A) (e : Ehat (pinr c)) : colAt c \elim e
    | pinl ca => ca
    | pinr pt => transport colAt (inv (cIsDiag c pt.2))
        (inP (Col.w0Diag {A} {x0} {x1} {x2} pt.1))

  \lemma rhoIsProp : isProp Rho =>
    \lam u v => SigmaPropPath {\Sigma A A} {\lam c => Ehat (pinr c)} colCodeIsProp (rhoVals u v) \where {
    \lemma rhoVals (u v : Rho) : u.1 = v.1 =>
      TruncP.rec prop-isProp (rhoColAt u.1 u.2) (\lam wu => TruncP.rec prop-isProp (rhoColAt v.1 v.2)
          (\lam wv => ext (Col.colValsDet {A} (inv wu *> wv))))
  }

  \lemma rightIsProp : isProp RightSplitP => transport isProp right= rhoIsProp

  \sfunc colRof (c : \Sigma A A) (w : w0 = collision c.1 c.2) : ColR => (c, inP w)

  \sfunc jOfCol (cr : ColR) : J w0 =>
    pinl (TruncP.rec prop-isProp cr.2 (\lam w => Col.colBothOf {A} {x0} {x1} {x2} w0 cr.1 w w))
  \sfunc jOfP (p : P) : J w0 => pinr (p, Qz0.Ty0FromP {A} {x0} {x1} {x2} p)

  \sfunc jOf (r : RightSplitP) : J w0 \elim r
    | pinl cr => jOfCol cr
    | pinr p => jOfP p
    | pglue b i => JisProp w0 (jOfCol (rCol b)) (jOfP b.2.2.1) i

  \sfunc jTo (j : J w0) : RightSplitP \elim j
    | pinl cb => pinl (TruncP.rec ColRisProp cb (\lam s => colRof (s.1, s.2) s.3.1))
    | pinr pt => pinr pt.1
    | pglue (cb, pt) i => rightIsProp
        (pinl (TruncP.rec ColRisProp cb (\lam s => colRof (s.1, s.2) s.3.1))) (pinr pt.1) i

  -- The base corner. Along the inner glue its fiber is the code at a collision
  -- point, which splits the same way.
  \func BOverlap : \oo-Type (\suc \lp) =>
    \Sigma (a : A21) (\Sigma (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3)))))

  \func BaseSplit : \oo-Type (\suc \lp) => PushoutData
      {BOverlap}
      {\Sigma (a : A21) (colAt (a.2, a.3))}
      {\Sigma (a : A21) (\Sigma P (T {A} {x0} (pinr (a.2, a.3))))}
      (\lam b => (b.1, b.2.1)) (\lam b => (b.1, b.2.2))

  \func BaseP : \oo-Type (\suc \lp) => \Sigma (a : A21) (Ehat (pinr (a.2, a.3)))

  -- The base corner's fiber, rewritten along the inner glue. This is written as an
  -- explicit `iso` rather than as a family path, so that its `path-fun` computes
  -- (`Ehat.fwd`/`Ehat.bwd` are the two directions of `innerGlue`); both round trips
  -- are propositional -- conditionally so on the Borel side.
  \sfunc baseFib= : Bfat = BaseP => iso to fro sec ret \where {
    \func to (u : Bfat) : BaseP => (u.1, Ehat.fwd u.1 u.2)
    \func fro (v : BaseP) : Bfat => (v.1, Ehat.bwd v.1 v.2)
    \sfunc sec (u : Bfat) : fro (to u) = u =>
      SigmaPath idp (condCtrToProp (Ehat.condCtr u.1) _ _)
    \sfunc ret (v : BaseP) : to (fro v) = v =>
      SigmaPath idp (colCodeIsProp (v.1.2, v.1.3) _ _)
  }

  \sfunc base= : Bfat = BaseSplit => baseFib= *> pushout-sigma _ _


  --
  -- A collision certificate lands in the collision stratum of the Borel cone, at
  -- the point `fatdiag a`; a diagonal certificate lands in the diagonal stratum
  -- over the `BSn 3` point of `fatdiag a`, which is `extendBSn 1 a.1`. The overlap
  -- of the two strata travels along the glue of `JSplitD` itself.

  -- For the time being, the function has been made non-explicit.
  -- If an explicit characterization is needed, this function can be revisited.
  -- However then lFun would become a major roadblock. If possible, try to avoid this route.
  \func lExpl (u : BaseSplit) : LeftCone => path-fun left= (lfat (path-fun (inv base=) u))

  -- The `BSn 2` coordinate is discarded and the certificate travels unchanged.
  -- `RightSplitP` is a proposition, so both this map's glue clause and its
  -- certification below are free.
  \sfunc rExpl (u : BaseSplit) : RightSplitP \elim u
    | pinl w => pinl ((w.1.2, w.1.3), w.2)
    | pinr d => pinr d.2.1
    | pglue b i => rightIsProp (pinl ((b.1.2, b.1.3), b.2.1)) (pinr b.2.2.1) i

  \func Lsplit : \oo-Type (\suc \lp) => PushoutData {BaseSplit} {LeftCone} {RightSplitP}
      (\lam a' => path-fun left= (lfat (path-fun (inv base=) a')))
      (\lam a' => path-fun right= (rfat (path-fun (inv base=) a')))

  -- The fully explicit model of the report (its `Qexpl`, at this level).
  \func LsplitE : \oo-Type (\suc \lp) => PushoutData {BaseSplit} {LeftCone} {RightSplitP} lExpl rExpl

  -- Certifying the Borel-side induced map -- the one remaining piece of item (iii).
  -- For the time being, deferred and replaced by a simpler version.
  -- The two point cases are computations with the betas now available:
  -- `pathFunInvComp` + `pushout-sigma.beta-inv-pinl` + `baseFib=`'s
  -- `path-fun.beta-inv` compute `path-fun (inv base=)`, and then
  -- `path-fun.beta-*>` + `pushout-sigma.beta-pinr` + `pushout-contr.beta-pinr` +
  -- `pushout-equiv.beta-pinl`/`beta-pinr` + `betaDelta` compute `path-fun left=`
  -- (both point values then come out as `lExpl`'s, which is how `lExpl` was read
  -- off in section 2 of the report). The `pglue` case is the two-dimensional
  -- coherence flagged there: the two point-case paths must agree over the glue of
  -- `JSplitD`, whose path types are not propositional.
  \sfunc lFun : (\lam a' => path-fun left= (lfat (path-fun (inv base=) a'))) = lExpl => idp

  -- The collision-side induced map needs no computation at all: its target is a
  -- proposition (`rightIsProp`), so any two maps into it agree.
  \sfunc rFun : (\lam a' => path-fun right= (rfat (path-fun (inv base=) a'))) = rExpl =>
    ext (\lam _ => rightIsProp _ _)

  \sfunc Lsplit=LsplitE : Lsplit = LsplitE => pushout-eqv-fun _ _ _ _ lFun rFun

  \sfunc Lchar : L = LsplitE =>
    inv Lflat=L *> pushout-equiv base= left= right= lfat rfat *> Lsplit=LsplitE

  \func QsmallSplit : \oo-Type (\suc \lp) => PushoutData {\Sigma C P} {LsplitE} {P}
      (\lam cp => path-fun Lchar (diagPoint cp)) __.2

  \sfunc Qsmall=QsmallSplit : Qsmall = QsmallSplit => pushout-equiv idp Lchar idp diagPoint __.2

  \sfunc contrQhat : Contr (\Sigma (z : gUT) (Qhat z)) =>
    transport Contr Qflat=Q (transport Contr (inv Qflat=Qsmall)
        (transport Contr (inv Qsmall=QsmallSplit) contrQsmallSplit))
  \func ctr0 : QsmallSplit => pinl (pinl (pinl ()))

  \sfunc viaCtr (c : Contr QsmallSplit) (xi : QsmallSplit) : ctr0 = xi => isContr=>isProp c ctr0 xi

  \sfunc glueOver (c : Contr QsmallSplit) (F : I -> QsmallSplit)
                  (p : ctr0 = F left) (q : ctr0 = F right) : Path (\lam i => ctr0 = F i) p q =>
    pathOver (isProp.=>isSet (isContr=>isProp c) _ _ _ _)

  -- `Contr QsmallSplit` is a proposition. Stated once, so that the truncation
  -- eliminations below do not each re-solve the levels of `Contr.levelProp`.
  \lemma ctrQsProp : isProp (Contr QsmallSplit) => Contr.levelProp QsmallSplit

  -- Contractibility from the certificate at the basepoint, and from each stratum
  -- of the model. The `pglue` clauses are all free, `Contr` being a proposition.
  \sfunc ctrJw0 (j : J w0) : Contr QsmallSplit \elim j
    | pinl cb => TruncP.rec ctrQsProp cb (\lam s => ctrW s.1 s.2 s.3.1)
    | pinr pt => ctrP pt.1

  \sfunc ctrColB (u : ColB) : Contr QsmallSplit =>
    TruncP.rec ctrQsProp u.2 (\lam s => ctrW s.1 s.2 s.3.1)

  \sfunc ctrJSplit (js : JSplitD) : Contr QsmallSplit \elim js
    | pinl u => ctrColB u
    | pinr pb => ctrP pb.1

  \sfunc ctrSpine (sp : Spine) : Contr QsmallSplit => ctrJw0 (transport J (inv sp.2.1) sp.2.2)

  \sfunc ctrRight (r : RightSplitP) : Contr QsmallSplit \elim r
    | pinl cr => TruncP.rec ctrQsProp cr.2 (\lam w => ctrW cr.1.1 cr.1.2 w)
    | pinr p => ctrP p

  \sfunc ctrBase (b : BaseSplit) : Contr QsmallSplit \elim b
    | pinl u => TruncP.rec ctrQsProp u.2 (\lam w => ctrW u.1.2 u.1.3 w)
    | pinr d => ctrP d.2.1

  -- The contraction itself: the tip is reflexivity, everything else rides the
  -- local contractibility.
  \sfunc tipPathLC (lc : LeftCone) : ctr0 = pinl (pinl lc) \elim lc
    | pinl () => idp
    | pinr js => viaCtr (ctrJSplit js) _
    | pglue sp i => glueOver (ctrSpine sp) (\lam j => pinl (pinl (pglue sp j))) idp
        (viaCtr (ctrJSplit (path-fun JSum=D (sp.1, sp.2.2))) _) @ i

  \sfunc tipPathL (l : LsplitE) : ctr0 = pinl l \elim l
    | pinl lc => tipPathLC lc
    | pinr r => viaCtr (ctrRight r) _
    | pglue b i => glueOver (ctrBase b) (\lam j => pinl (pglue b j))
        (tipPathLC (lExpl b)) (viaCtr (ctrRight (rExpl b)) _) @ i

  \sfunc tipPath (xi : QsmallSplit) : ctr0 = xi \elim xi
    | pinl l => tipPathL l
    | pinr p => viaCtr (ctrP p) _
    | pglue cp i => glueOver (ctrP cp.2) (\lam j => pglue cp j)
        (tipPathL (path-fun Lchar (diagPoint cp))) (viaCtr (ctrP cp.2) _) @ i

  \sfunc contrQsmallSplit : Contr QsmallSplit \cowith
    | center => ctr0
    | contraction => tipPath

  -- The diagonal certificate over the whole of SP3 A. Its glue is exactly the pair
  -- `diagTToEq`/`diagT`.
  \func Tg (_ : gUT) : \Prop
    | pinl s => T {A} {x0} s
    | pinr x => x = x0
    | pglue a i => tgGlue a i \where {
    \func tgGlue (a : \Sigma C A) : T {A} {x0} (SP3.diag a) = (a.2 = x0) =>
      propExtEx (TisProp {A} {x0} (SP3.diag a)) prop-isProp (diagTToEq a) (diagT a)
  }

  -- The diagonal certificate over the inner pushout, with its prop-ness declared in
  -- the type -- that is what makes the glue clauses of the maps below free.
  \func Tp (s : iUT) : \Prop => T {A} {x0} s

  -- A diagonal certificate makes the code fiber contractible.
  \sfunc ehatCtrFromT (p : P) (s : iUT) (t : Tp s) : Contr (Ehat s) \elim s
    | pinl bv => Join_Contr (w0 = bv) (isProp=>isContr (JisProp bv) (pinr (p, t)))
    | pinr c => isProp=>isContr (colCodeIsProp c) (pinr (p, t))

  -- Conversely each inhabitant of the code yields one, so the fibers are props.
  \sfunc borelToT (p : P) {bv : hUT} (h : w0 = bv) : Tp (pinl bv) =>
    transport (\lam u => T {A} {x0} (pinl u)) h (Qz0.Ty0FromP {A} {x0} {x1} {x2} p)

  \sfunc jToT (p : P) (bv : hUT) (j : J bv) : Tp (pinl bv) \elim j
    | pinl cb => TruncP.rec (TisProp {A} {x0} (pinl bv)) cb
        (\lam s => borelToT p (s.3.1 *> inv s.3.2))
    | pinr pt => pt.2

  \sfunc ehatToTL (p : P) (bv : hUT) (e : Join (w0 = bv) (J bv)) : Tp (pinl bv) \elim e
    | pinl h => borelToT p h
    | pinr j => jToT p bv j

  \sfunc ehatToTR (p : P) (c : \Sigma A A) (e : Join (colAt c) (\Sigma P (T {A} {x0} (pinr c))))
    : Tp (pinr c) \elim e
    | pinl ca => TruncP.rec (TisProp {A} {x0} (pinr c)) ca
        (\lam w => \let v => Col.colValsDet {A} (inv (Col.w0Diag {A} {x0} {x1} {x2} p) *> w)
                   \in (inv v.1, inv v.2))
    | pinr pt => pt.2

  \sfunc ehatToT (p : P) (s : iUT) (e : Ehat s) : Tp s \elim s
    | pinl bv => ehatToTL p bv e
    | pinr c => ehatToTR p c e

  \sfunc ehatCtr (p : P) (bv : hUT) (e : Join (w0 = bv) (J bv)) : Contr (Join (w0 = bv) (J bv)) =>
    ehatCtrFromT p (pinl bv) (ehatToTL p bv e)

  \lemma ehatIsProp (p : P) (s : iUT) : isProp (Ehat s) \elim s
    | pinl bv => isContr'=>isProp (ehatCtr p bv)
    | pinr c => colCodeIsProp c

  \lemma qhatIsProp (p : P) (z : gUT) : isProp (Qhat z) \elim z
    | pinl s => ehatIsProp p s
    | pinr x => prop-isProp

  \sfunc qhatToTg (p : P) (z : gUT) (e : Qhat z) : Tg z \elim z
    | pinl s => ehatToT p s e
    | pinr x => e.2

  \sfunc tgCtrQhat (p : P) (z : gUT) (t : Tg z) : Contr (Qhat z) \elim z
    | pinl s => ehatCtrFromT p s t
    | pinr x => isProp=>isContr prop-isProp (p, t)

  -- Hence the code is the certificate, fiberwise, and so on the total space.
  \sfunc qhatEqTg (p : P) (z : gUT) : Qhat z = (\Sigma P (Tg z)) =>
    propExtEx (qhatIsProp p z) prop-isProp
        (\lam e => (p, qhatToTg p z e)) (\lam t => (tgCtrQhat p z t.2).center)

  \sfunc totalEqTg (p : P) : (\Sigma (z : gUT) (Qhat z)) = (\Sigma (z : gUT) (\Sigma P (Tg z))) =>
    path (\lam i => \Sigma (z : gUT) (qhatEqTg p z i))

  \sfunc regroupTg : (\Sigma (z : gUT) (\Sigma P (Tg z))) = (\Sigma P (\Sigma (z : gUT) (Tg z))) =>
    iso to fro (\lam _ => idp) (\lam _ => idp) \where {
    \func to (u : \Sigma (z : gUT) (\Sigma P (Tg z))) : \Sigma P (\Sigma (z : gUT) (Tg z)) =>
      (u.2.1, (u.1, u.2.2))
    \func fro (u : \Sigma P (\Sigma (z : gUT) (Tg z))) : \Sigma (z : gUT) (\Sigma P (Tg z)) =>
      (u.2.1, (u.1, u.2.2))
  }

  \sfunc totalEqDiag (p : P) : (\Sigma (z : gUT) (Qhat z)) = (\Sigma (z : gUT) (Tg z)) =>
    totalEqTg p *> regroupTg
                     *> QEquiv-to-= (contr-left (isProp=>isContr prop-isProp p) {\lam _ => \Sigma (z : gUT) (Tg z)})

  \sfunc total=QsmallSplit : (\Sigma (z : gUT) (Qhat z)) = QsmallSplit =>
    inv Qflat=Q *> Qflat=Qsmall *> Qsmall=QsmallSplit

  \sfunc ctrP (p : P) : Contr QsmallSplit =>
    transport Contr total=QsmallSplit (transport Contr (inv (totalEqDiag p)) contrDiagLocus)

  \func Base : \oo-Type (\suc \lp) => \Sigma (a : \Sigma C A) (Tp (SP3.diag a))
  \func Mid : \oo-Type (\suc \lp) => \Sigma (s : iUT) (Tp s)
  \func RightA : \Type \lp => \Sigma (x : A) (x = x0)

  \func fLeg (q : Base) : Mid => (SP3.diag q.1, q.2)
  \func gLeg (q : Base) : RightA => (q.1.2, transport Tg (PushoutData.ppglue q.1) q.2)

  \sfunc locusFlat : PushoutData {Base} {Mid} {RightA} fLeg gLeg = (\Sigma (z : gUT) (Tg z)) =>
    PushoutData.flattening Tg

  -- The inverse of the left leg reads the C-coordinate off a point of the inner
  -- pushout. It needs no certificate at all, and -- crucially -- its glue clause is
  -- C's own glue DEFINITIONALLY, which is what makes the round trips compute.
  \func rCdirect (s : iUT) : C \elim s
    | pinl bv => pinl bv.1
    | pinr c => pinr ()
    | pglue a i => pglue a.1 i

  -- The base corner IS `C`: the A-coordinate is pinned to x0 by the certificate, and
  -- pinning it needs no induction (`\Sigma C A` is a product, and `diagTToEq` supplies
  -- the value).
  \func baseC= : Base = C => iso to fro sec ret \where {
    \func to (q : Base) : C => q.1.1
    \func fro (c : C) : Base => ((c, x0), diagT (c, x0) idp)
    \sfunc sec (q : Base) : fro (to q) = q =>
      SigmaPropPath (\lam v => TisProp {A} {x0} (SP3.diag v))
          (pmap (\lam (v : A) => (q.1.1, v)) (inv (diagTToEq q.1 q.2)))
    \sfunc ret (c : C) : to (fro c) = c => idp
  }

  \func fC (c : C) : Mid => (SP3.diag (c, x0), diagT (c, x0) idp)
  \func gC (c : C) : RightA => (x0, transport Tg (PushoutData.ppglue (c, x0)) (diagT (c, x0) idp))

  \lemma rightAContr : Contr RightA => rsigma x0

  \sfunc locusC : PushoutData {Base} {Mid} {RightA} fLeg gLeg = PushoutData {C} {Mid} {RightA} fC gC =>
    pushout-equiv baseC= (idp : Mid = Mid) (idp : RightA = RightA) fLeg gLeg
      *> pushout-eqv-fun _ _ _ _ pfC pgC \where {
    \sfunc pfC : (\lam c => path-fun (idp : Mid = Mid) (fLeg (path-fun (inv baseC=) c))) = fC => run {
      unfold baseC=,
      rewrite (path-fun.beta-inv baseC=.to baseC=.fro baseC=.sec baseC=.ret),
      idp
    }
    -- The right leg needs no computation: `RightA` is contractible.
    \sfunc pgC : (\lam c => path-fun (idp : RightA = RightA) (gLeg (path-fun (inv baseC=) c))) = gC =>
      ext (\lam _ => isContr=>isProp rightAContr _ _)
  }

  -- With the base corner pinned, the round trip on `C` is the IDENTITY on both point
  -- constructors.
  \func rC (m : Mid) : C => rCdirect m.1

  -- The two coherences of `Equiv fC` -- all that is left of `contrDiagLocus`.
  --
  -- The first round trip is the identity, on the nose on both point constructors.
  \sfunc retC (c : C) : rC (fC c) = c \elim c
    | pinl b => idp
    | pinr () => idp
    | pglue b i => retCGlue b i

  -- `SP3.diag`'s glue clause is the structural glue of the inner pushout, transported
  -- along the tuple correction `orConst`. `rCdirect` ignores tuples, so generalizing
  -- that correction to an arbitrary path and doing path induction on it reduces the
  -- square to the structural glue -- where it holds by `rCdirect`'s own glue clause,
  -- definitionally.
  \sfunc retCGlueGen {b : BSn 2} {f0 f1 : Or b.1 (Fin 1) -> A} (q : f0 = f1)
                     (e : pinl (extendBSn 1 b, f1) = {iUT} pinr (x0, x0))
                     (h : Path (\lam i => rCdirect (e @ i) = pglue b i) idp idp)
    : Path (\lam i => rCdirect (transportInv (\lam (f : Or b.1 (Fin 1) -> A) =>
      pinl (extendBSn 1 b, f) = {iUT} pinr (x0, x0)) q e @ i) = pglue b i) idp idp \elim q
    | idp => h

  \sfunc retCGlue (b : BSn 2)
    : Path (\lam i => rCdirect (SP3.diag (pglue b i, x0)) = pglue b i) idp idp =>
    retCGlueGen (orConst x0) (path (pglue (b, x0, x0))) (path (\lam _ => idp))

  \func pairPath {u v : \Sigma A A} (p : u.1 = v.1) (q : u.2 = v.2) : u = v =>
    path (\lam j => (p j, q j))

  \func diagTuple (b : BSn 2) (f : Or b.1 (Fin 1) -> A) : iUT => pinl (extendBSn 1 b, f)

  -- `SP3.diag`'s glue clause is the structural glue with the tuple correction
  -- prepended.
  \sfunc diagGlueSplit (b : BSn 2)
    : path (\lam i => SP3.diag (pglue b i, x0))
    = pmap (diagTuple b) (orConst x0) *> path (pglue (b, x0, x0)) =>
    transportInvPath (diagTuple b) (pinr (x0, x0)) (orConst x0) (path (pglue (b, x0, x0)))

  -- The square. Generalizing over the two collision values and inducting on their
  -- paths to x0 collapses everything: with x = y = x0 the right-hand correction is
  -- `idp`, and the left-hand one is the very `orConst` correction that `SP3.diag`'s
  -- glue carries -- the two cancel.
  \sfunc secSquare (b : BSn 2) (x y : A) (qx : x = x0) (qy : y = x0)
                   (tL : Tp (pinl (SP3.fatdiag (b, x, y))))
    : inv (path (\lam i => SP3.diag (pglue b i, x0)))
    *> pmap pinl (SigmaPath {BSn 3} {\lam (X : BSn 3) => X.1 -> A}
      {(SP3.fatdiag (b, x, y)).1, \lam _ => x0} {SP3.fatdiag (b, x, y)} idp (inv tL))
         *> path (pglue (b, x, y))
    = pmap pinr (pairPath (inv qx) (inv qy)) \elim qx, qy
    | idp, idp => run {
      rewrite (diagGlueSplit b),
      rewrite (set-pi {Or b.1 (Fin 1) -> A} {\lam _ => x0}
          {Or.rec {b.1} {Fin 1} (\lam _ => x0) (\lam _ => x0)} {inv tL} {orConst x0}),
      rewrite (sigmaFib {BSn 3} {\lam (X : BSn 3) => X.1 -> A} {extendBSn 1 b} (orConst x0)),
      rewrite (pmap-comp (\lam (f : Or b.1 (Fin 1) -> A) => ((extendBSn 1 b, f) : hUT))
          (\lam (bv : hUT) => (pinl bv : iUT)) (orConst x0)),
      inv_*> _
    }

  \sfunc secGlue (a : A21)
    : Path (\lam i => \Pi (t : Tp (pglue a i)) -> SP3.diag (pglue a.1 i, x0) = pglue a i)
      (\lam t => pmap pinl (SigmaPath {BSn 3} {\lam (X : BSn 3) => X.1 -> A}
          {(SP3.fatdiag a).1, \lam _ => x0} {SP3.fatdiag a} idp (inv t)))
      (\lam t => pmap pinr (pairPath (inv t.1) (inv t.2))) =>
    pathOver (coe_pi *> ext (\lam t => coe_path _ _ _ *> secSquare a.1 a.2 a.3 t.1 t.2 _))

  \sfunc secBase (s : iUT) (t : Tp s) : (fC (rC (s, t))).1 = s \elim s
    | pinl bv => pmap pinl (SigmaPath {BSn 3} {\lam (X : BSn 3) => X.1 -> A}
        {bv.1, \lam _ => x0} {bv} idp (inv t))
    | pinr c => pmap pinr (pairPath (inv t.1) (inv t.2))
    | pglue a i => secGlue a i t

  \sfunc secC (m : Mid) : fC (rC m) = m =>
    SigmaPropPath (\lam s => TisProp {A} {x0} s) (secBase m.1 m.2)

  \sfunc fCequiv : QEquiv fC \cowith
    | ret => rC
    | ret_f => retC
    | f_sec => secC

  \sfunc locusEq : (\Sigma (z : gUT) (Tg z)) = RightA =>
    inv locusFlat *> locusC *> pushout-cobase-eqv fCequiv gC

  \sfunc contrDiagLocus : Contr (\Sigma (z : gUT) (Tg z)) =>
    transport Contr (inv locusEq) rightAContr

  -- --------------------------------------------------------------------------
  -- Item (vi): the contraction lemma, THE REMAINING GAP.
  --
  -- `ctrW`: with an honest collision and no `P`, pointwise paths genuinely do not
  -- exist (with x /= y the component is coned by an equivalence), so the space
  -- must be normalized first: `ColR` is an inhabited proposition, `Col.compChar`
  -- makes the collision fiber independent of the certificate, `Col.colValsDet`
  -- pins the values, and the result is the report's `Xw`. Its contractibility is
  -- the kernel: the same architecture one level down, with `P` replaced by the
  -- bare set-equality `x = y` and the basepoint `collision x y`, where the
  -- transposition case is killed by the honest `BSn 2`-cone (`pushout-kill-conj`,
  -- still commented out in `Utils.ard`) rather than certified into a further
  -- stratum -- which is why that recursion terminates. Section 7 of the report.
  -- --------------------------------------------------------------------------
  -- BLOCKED, together with `qPath` below (see the note there). The closing step
  -- is
  --   contrTransport QsmallSplit=Qw contrQw
  -- which is well typed, but it pins the homotopy level shared by this `\where`
  -- block, and that bound then propagates out to the `Contr.levelProp` calls of
  -- `ctrJw0`/`ctrColB`/`ctrBase` above.
  \func ctrW (x y : A) (w : w0 = collision x y) : Contr QsmallSplit => {?} \where {
    -- The strict collision tuple over the `BSn 2` point `b`, with the values of
    -- `w` fixed. Its path theory is `FatPath.ard`.
    \func fatxy (b : BSn 2) : hUT => fatVal {A} {x} {y} b

    \func cr0 : ColR => ((x, y), inP w)

    \func kCol (b : BSn 2) : ColB =>
      (fatxy b, Ehat.fromColAt (b, x, y) (inP w))

    \func Kw : \oo-Type (\suc \lp) =>
      PushoutData {BSn 2} {ColB} {\Sigma} kCol (\lam _ => ())

    \func rightWCtr : Contr RightSplitP =>
      isProp=>isContr rightIsProp (pinl cr0)

    \func rightW= : RightSplitP = (\Sigma) => isContrEqUnit rightWCtr

    \func cbw0 : colBoth w0 =>
      Col.colBothOf w0 (x, y) w w

    \func sp0 : Spine => (w0, (idp, pinl cbw0))

    -- The fibers of `JOverlap` over the Borel point are propositional.
    \lemma jOverlapFib (bv : hUT) : isProp (\Sigma (colBoth bv) (\Sigma P (T {A} {x0} (pinl bv)))) =>
      \lam _ _ => SigmaPath prop-pi (SigmaPath prop-pi (TisProp {A} {x0} (pinl bv) _ _))

    -- The diagonal leg of `JSplitD` is an equivalence: the certificate pins the
    -- tuple, and the collision decoration is then automatic (`Col.colBothDiag`).
    \func jDiag= : QEquiv {JOverlap} {\Sigma P (BSn 3)} => \new QEquiv {
      | f (u : JOverlap) => (u.2.2.1, u.1.1)
      | ret (pb : \Sigma P (BSn 3)) =>
        ((pb.2, \lam _ => x0),
         (Col.colBothDiag pb.1 pb.2, (pb.1, idp)))
      | ret_f (u : JOverlap) => SigmaPropPath jOverlapFib (ext (idp, inv u.2.2.2))
      | f_sec (_ : \Sigma P (BSn 3)) => idp
    }

    \sfunc JSplit= : JSplitD = ColB => pushout-cobase-eqv.right jDiag= jCol

    -- `Spine` is a proposition: its honest-path part is contractible and what is
    -- left is the certificate. Under `w` it is inhabited by `sp0`, so its leg to the
    -- cone point is an equivalence.
    \sfunc spineRegroup : Spine = (\Sigma (s : \Sigma (bv : hUT) (w0 = bv)) (J s.1)) =>
      iso to fro (\lam _ => idp) (\lam _ => idp) \where {
      \func to (u : Spine) : \Sigma (s : \Sigma (bv : hUT) (w0 = bv)) (J s.1) => ((u.1, u.2.1), u.2.2)
      \func fro (u : \Sigma (s : \Sigma (bv : hUT) (w0 = bv)) (J s.1)) : Spine => (u.1.1, (u.1.2, u.2))
    }

    \sfunc spine= : Spine = J w0 =>
      spineRegroup *> QEquiv-to-= (contr-left (lsigma w0)
          {\lam (s : \Sigma (bv : hUT) (w0 = bv)) => J s.1})

    \lemma spineIsProp : isProp Spine => transport isProp (inv spine=) (JisProp w0)

    -- `spineEqv` and `jDiag=` stay transparent: the collapse lemmas below are applied
    -- at them, so their coercions have to match the legs of `LeftCone`/`JSplitD`
    -- definitionally. Everything built FROM them is opaque, and unfolded by `\peval`
    -- exactly where a beta is needed.
    \func spineEqv : QEquiv {Spine} {\Sigma} => \new QEquiv {
      | f _ => ()
      | ret _ => sp0
      | ret_f s => spineIsProp sp0 s
      | f_sec _ => idp
    }

    \func spineLeg (b : Spine) : JSplitD => path-fun JSum=D (b.1, b.2.2)

    \sfunc leftCone= : LeftCone = JSplitD => pushout-cobase-eqv spineEqv spineLeg

    \sfunc leftW= : LeftCone = ColB => leftCone= *> JSplit=

    \sfunc leftWBeta (u : ColB) : path-fun leftW= (pinr (pinl u)) = u => run {
      rewrite (\peval leftW=),
      rewrite (path-fun.beta-*> leftCone= JSplit=),
      rewrite (\peval leftCone=),
      rewrite (pushout-cobase-eqv.beta spineEqv spineLeg (pinl u)),
      rewrite (\peval JSplit=),
      pushout-cobase-eqv.rightBeta jDiag= jCol u
    }

    -- ------------------------------------------------------------------------
    -- `BaseSplit` is `BSn 2`. Its diagonal leg is an equivalence (forgetting an
    -- inhabited propositional certificate), and its collision corner has the
    -- values pinned by `w`.
    -- ------------------------------------------------------------------------
    \func BCol : \oo-Type (\suc \lp) => \Sigma (a : A21) (colAt (a.2, a.3))
    \func BDiag : \oo-Type (\suc \lp) => \Sigma (a : A21) (\Sigma P (T {A} {x0} (pinr (a.2, a.3))))

    -- On the diagonal corner the values are x0, so `Col.w0Diag` gives the collision
    -- certificate back.
    \func colAtOfDiag (d : BDiag) : colAt (d.1.2, d.1.3) =>
      transport colAt (inv (cIsDiag (d.1.2, d.1.3) d.2.2))
          (inP (Col.w0Diag {A} {x0} {x1} {x2} d.2.1))

    \lemma bOverlapFib (a : A21)
      : isProp (\Sigma (colAt (a.2, a.3)) (\Sigma P (T {A} {x0} (pinr (a.2, a.3))))) =>
      \lam _ _ => SigmaPath prop-pi (SigmaPath prop-pi (TisProp {A} {x0} (pinr (a.2, a.3)) _ _))

    \func bFwd (b : BOverlap) : BDiag => (b.1, b.2.2)
    \func bBwd (d : BDiag) : BOverlap => (d.1, (colAtOfDiag d, d.2))
    \func bColLeg (b : BOverlap) : BCol => (b.1, b.2.1)

    \func bDiagEqv : QEquiv {BOverlap} {BDiag} => \new QEquiv {
      | f => bFwd
      | ret => bBwd
      | ret_f (_ : BOverlap) => SigmaPropPath bOverlapFib idp
      | f_sec (_ : BDiag) => idp
    }

    \sfunc baseCol= : BaseSplit = BCol => pushout-cobase-eqv.right bDiagEqv bColLeg

    -- The collision corner is `BSn 2`: the values of a collision are determined, so
    -- under `w` they are `x` and `y`.
    \func kBase (b : BSn 2) : BCol => ((b, x, y), inP w)

    \lemma bVals (u : BCol) : \Sigma (u.1.2 = x) (u.1.3 = y) =>
      TruncP.rec {_} {\Sigma (u.1.2 = x) (u.1.3 = y)} prop-isProp u.2
          (\lam wu => Col.colValsDet {A} (inv wu *> w))

    \sfunc bCol= : BCol = BSn 2 => iso f kBase sec ret \where {
      \func f (u : BCol) : BSn 2 => u.1.1
      \sfunc sec (u : BCol) : kBase (f u) = u =>
        SigmaPropPath {A21} {\lam a => colAt (a.2, a.3)} (\lam _ => prop-isProp)
            {kBase (f u)} {u} (ext (idp, inv (bVals u).1, inv (bVals u).2))
      \func ret (b : BSn 2) : f (kBase b) = b => idp
    }

    \sfunc baseW= : BaseSplit = BSn 2 => baseCol= *> bCol=

    -- The inverse lands in the collision constructor -- this is what keeps the
    -- `BaseSplit.pglue` clause out of the computation below.
    \sfunc baseWInvBeta (b : BSn 2) : path-fun (inv baseW=) b = pinl (kBase b) => run {
      rewrite (\peval baseW=),
      rewrite (pathFunInvComp baseCol= bCol= b),
      rewrite (\peval bCol=),
      rewrite (path-fun.beta-inv bCol=.f kBase bCol=.sec bCol=.ret),
      rewrite (\peval baseCol=),
      pushout-cobase-eqv.rightInvBeta bDiagEqv bColLeg (kBase b)
    }

    -- ------------------------------------------------------------------------
    -- The only evaluation of the Borel leg `lExpl` needed anywhere: at the
    -- collision point `pinl (kBase b)`. The `BaseSplit.pglue` clause never
    -- occurs, which is the whole point of `baseWInvBeta`.
    -- ------------------------------------------------------------------------

    -- Step 1: undo the inner flattening. `Ehat.bwd` sends a collision certificate
    -- to the collision stratum of the certificate join, by definition.
    \sfunc baseInvBeta (b : BSn 2)
      : path-fun (inv base=) (pinl (kBase b))
      = ((b, x, y), pinr (pinl (Ehat.fromColAt (b, x, y) (inP w)))) => run {
      rewrite (\peval base=),
      rewrite (pathFunInvComp baseFib= _ (pinl (kBase b))),
      rewrite (pushout-sigma.beta-inv-pinl (kBase b)),
      rewrite (\peval baseFib=),
      rewrite (path-fun.beta-inv baseFib=.to baseFib=.fro baseFib=.sec baseFib=.ret),
      idp
    }

    -- Step 2: the Borel splitting, on the collision stratum.
    \sfunc jSumDBeta (b : BSn 2)
      : path-fun JSum=D (fatxy b, pinl (Ehat.fromColAt (b, x, y) (inP w))) = pinl (kCol b) => run {
      rewrite (\peval JSum=D),
      rewrite (path-fun.beta-*> JSum= _),
      rewrite (path-fun.beta-*> (pushout-equiv idp idp Delta= jCol jDl) _),
      rewrite (jSumBetaPinl (fatxy b) (Ehat.fromColAt (b, x, y) (inP w))),
      rewrite (pushout-equiv.beta-pinl idp idp Delta= jCol jDl (kCol b)),
      rewrite (pushout-eqv-fun.beta-pinl _ _ _ _ _ _ (kCol b)),
      idp
    }

    -- Step 3: the Borel corner. Only the `pinr` (non-spine) side is touched.
    \sfunc leftBeta (b : BSn 2)
      : path-fun left= (fatxy b, pinr (pinl (Ehat.fromColAt (b, x, y) (inP w))))
      = pinr (pinl (kCol b)) => run {
      rewrite (\peval left=),
      rewrite (path-fun.beta-*> left=leftSum _),
      rewrite (path-fun.beta-*> leftSum=leftCtr _),
      rewrite (leftSumBetaPinr (fatxy b) (pinl (Ehat.fromColAt (b, x, y) (inP w)))),
      rewrite (leftCtrBetaPinr
          ((fatxy b, pinl (Ehat.fromColAt (b, x, y) (inP w))) : \Sigma (bv : hUT) (J bv))),
      rewrite (pushout-equiv.beta-pinr idp idp JSum=D
          (\lam (_ : Spine) => ()) (\lam (s : Spine) => (s.1, s.2.2))
          ((fatxy b, pinl (Ehat.fromColAt (b, x, y) (inP w))) : \Sigma (bv : hUT) (J bv))),
      rewrite (jSumDBeta b),
      idp
    }

    \sfunc lWBetaAt (b : BSn 2) : path-fun leftW= (lExpl (path-fun (inv baseW=) b)) = kCol b => run {
      rewrite (baseWInvBeta b),
      unfold lExpl,
      rewrite (baseInvBeta b),
      unfold lfat,
      rewrite (leftBeta b),
      leftWBeta (kCol b)
    }

    \sfunc lWBeta : (\lam (b : BSn 2) => path-fun leftW= (lExpl (path-fun (inv baseW=) b))) = kCol =>
      ext lWBetaAt

    -- ------------------------------------------------------------------------
    -- The `w`-local normal form: `LsplitE` is the cone `Kw` on the strict
    -- collision presentation, and `QsmallSplit` is `Qw`. The outer left map stays
    -- opaque -- the contraction below never inspects it.
    -- ------------------------------------------------------------------------
    \sfunc Lw= : LsplitE = Kw =>
      pushout-equiv baseW= leftW= rightW= lExpl rExpl
          *> pushout-eqv-fun _ _ _ _ lWBeta ext

    -- The outer left map, kept opaque: the contraction below never inspects it.
    \sfunc qLeft (cp : \Sigma C P) : Kw => path-fun Lw= (path-fun Lchar (diagPoint cp))

    \func Qw : \oo-Type (\suc \lp) => PushoutData {\Sigma C P} {Kw} {P} qLeft (\lam cp => cp.2)

    \sfunc QsmallSplit=Qw : QsmallSplit = Qw =>
      pushout-equiv idp Lw= idp (\lam cp => path-fun Lchar (diagPoint cp)) (\lam cp => cp.2)
          *> pushout-eqv-fun _ _ _ _ (ext (\lam cp => inv (\peval qLeft cp))) idp

    -- Section 5 of the report -- the only new mathematics -- lives in
    -- `FatPath.ard`, which knows nothing about the basepoint `w0`: a path
    -- between two strict presentations either comes from a path of `BSn 2`
    -- points (`lifted`) or forces `x = y` (`diagonal`).
    \sfunc charOf (b' b : BSn 2) (p : fatxy b' = fatxy b) : FatPathChar {A} {x} {y} b' b p =>
      fatPathChar {A} {x} {y} b' b p

    -- ------------------------------------------------------------------------
    -- Section 4: the terminating strict-collision code. `Strict bv` is an honest
    -- presentation of `bv` by the binary-collision map with the values `x`, `y`
    -- FIXED; `Diag bv` says the two values have merged and `bv` is diagonal. The
    -- join lets a path move between the two presentations when both exist.
    -- ------------------------------------------------------------------------
    \func V : \Prop => x = y

    \func Strict (bv : hUT) : \oo-Type (\suc \lp) => \Sigma (b : BSn 2) (fatxy b = bv)

    \func Diag (bv : hUT) : \Prop => \Sigma V (bv.2 = (\lam _ => x))

    \lemma diagIsProp (bv : hUT) : isProp (Diag bv) => prop-isProp

    \func WCode (bv : hUT) : \oo-Type (\suc \lp) => Join (Strict bv) (Diag bv)

    \func wl {bv : hUT} (s : Strict bv) : WCode bv => pinl s
    \func wr {bv : hUT} (d : Diag bv) : WCode bv => pinr d
    \func wGlue {bv : hUT} (s : Strict bv) (d : Diag bv) : wl s = wr d => path (pglue (s, d))

    -- ------------------------------------------------------------------------
    -- Section 6: `WCode` is a proposition. Unlike a code with a truncated strict
    -- factor, `Strict (fatxy b)` has the canonical centre `(b, idp)`, so the cone
    -- attachment below needs no untruncated path out of connectedness.
    -- ------------------------------------------------------------------------
    \func fatDiag (b : BSn 2) (v : x = y) : (fatxy b).2 = (\lam _ => x) =>
      ext (\case \elim __ \with {
        | inl _ => idp
        | inr fzero => inv v
      })

    \func strictEq {b' b : BSn 2} {p : fatxy b' = fatxy b} (q : b' = b) (e : pmap fatxy q = p)
      : (b, idp) = {Strict (fatxy b)} (b', p) \elim q, e
      | idp, idp => idp

    \func fatReduce (b : BSn 2) (s : Strict (fatxy b)) : wl (b, idp) = wl s =>
      \case charOf s.1 b s.2 \with {
        | lifted q e => pmap (\lam (t : Strict (fatxy b)) => wl t) (strictEq q e)
        | diagonal v => \let d : Diag (fatxy b) => (v, fatDiag b v)
                        \in wGlue (b, idp) d *> inv (wGlue s d)
      }

    \func fatCtr (b : BSn 2) : Contr (WCode (fatxy b)) =>
      joinEqLeftP {Strict (fatxy b)} {Diag (fatxy b)} (diagIsProp (fatxy b)) (b, idp) (fatReduce b)

    \sfunc codeCondCtr (bv : hUT) (e : WCode bv) : Contr (WCode bv) \elim e
      | pinl s => transport (\lam (z : hUT) => Contr (WCode z)) s.2 (fatCtr s.1)
      | pinr d => Join_Contr (Strict bv) (isProp=>isContr (diagIsProp bv) d)

    \lemma WCodeIsProp (bv : hUT) : isProp (WCode bv) => condCtrToProp (codeCondCtr bv)

    -- ------------------------------------------------------------------------
    -- Section 7: every point of the collision stratum carries a code. The
    -- presentation is obtained by composing through `w0`; the collision values
    -- are never compared.
    -- ------------------------------------------------------------------------
    \lemma codeOfCol (u : ColB) : WCode u.1 =>
      TruncP.rec (WCodeIsProp u.1) u.2
          (\lam s => wl (BSnbase 2, inv w *> s.3.1 *> inv s.3.2))

    -- ------------------------------------------------------------------------
    -- Section 8: the contraction of `Qw`.
    -- ------------------------------------------------------------------------
    \sfunc ctrPW (p : P) : Contr Qw =>
      contrTransport (inv QsmallSplit=Qw) (ctrP p)

    \func kIn (u : ColB) : Kw => pinl u
    \func kTip : Kw => pinr ()
    \func kGlue (b : BSn 2) : kIn (kCol b) = kTip => path (pglue b)
    \func qIn (k : Kw) : Qw => pinl k

    \func cw : Qw => qIn kTip

    \sfunc viaCtrW (c : Contr Qw) (z : Qw) : cw = z => isContr=>isProp c cw z

    \sfunc glueOverW (c : Contr Qw) (F : I -> Qw) (p : cw = F left) (q : cw = F right)
      : Path (\lam i => cw = F i) p q => pathOver (isProp.=>isSet (isContr=>isProp c) _ _ _ _)

    -- A diagonal witness turns `w` into a diagonal collision, hence into `P`,
    -- which activates the already proven `ctrP`.
    \sfunc eqToP (q : x = y) : P => (diagonalPinr x (w *> pmap (collision x) (inv q))).1

    -- `colBoth` is a proposition, so a path of Borel points is a path of `ColB`.
    \func colBPath (b : BSn 2) (u : ColB) (p : fatxy b = u.1) : kCol b = u =>
      SigmaPropPath {hUT} {colBoth} (\lam _ => prop-isProp) p

    \func colBPathIdp (b : BSn 2) : colBPath b (kCol b) idp = idp =>
      SigmaPropPathBeta {hUT} {colBoth} (\lam _ => prop-isProp) (idp {ColB} {kCol b})

    -- A strict presentation walks to the tip of the cone `Kw`; a diagonal one
    -- goes through `ctrP`.
    \func strictPath (u : ColB) (s : Strict u.1) : cw = qIn (kIn u) =>
      pmap qIn (inv (kGlue s.1) *> pmap kIn (colBPath s.1 u s.2))

    \func diagPath (u : ColB) (d : Diag u.1) : cw = qIn (kIn u) =>
      viaCtrW (ctrPW (eqToP d.1)) (qIn (kIn u))

    -- The join coherence is free: its index carries the diagonal witness.
    \func repPath (u : ColB) (e : WCode u.1) : cw = qIn (kIn u) \elim e
      | pinl s => strictPath u s
      | pinr d => diagPath u d
      | pglue (s, d) i => glueOverW (ctrPW (eqToP d.1)) (\lam _ => qIn (kIn u))
          (strictPath u s) (diagPath u d) @ i

    \func colPath (u : ColB) : cw = qIn (kIn u) => repPath u (codeOfCol u)

    -- ------------------------------------------------------------------------
    -- The cone coherence of `Kw`. At `kCol b` proof irrelevance moves the
    -- selected code to the canonical strict one, and what is left is the
    -- canonical path over the structural glue.
    -- ------------------------------------------------------------------------
    \func codeAtKBeta (b : BSn 2) : codeOfCol (kCol b) = wl (b, idp) => WCodeIsProp (fatxy b) _ _

    \func strictPathBeta (b : BSn 2) : repPath (kCol b) (wl (b, idp)) = pmap qIn (inv (kGlue b)) =>
      pmap (\lam (t : kIn (kCol b) = kIn (kCol b)) => pmap qIn (inv (kGlue b) *> t))
          (pmap (pmap kIn) (colBPathIdp b))

    \func colPathAtK (b : BSn 2) : colPath (kCol b) = inv (pmap qIn (kGlue b)) =>
      pmap (repPath (kCol b)) (codeAtKBeta b) *> strictPathBeta b
        *> pmap_inv-comm qIn (kGlue b)

    \func kGlueOver (b : BSn 2)
      : Path (\lam i => cw = qIn (pglue b i)) (colPath (kCol b)) idp =>
      transport (\lam (t : cw = qIn (kIn (kCol b))) => Path (\lam i => cw = qIn (pglue b i)) t idp)
          (inv (colPathAtK b)) (invPathOver (pmap qIn (kGlue b)))

    \func kPath (k : Kw) : cw = qIn k \elim k
      | pinl u => colPath u
      | pinr () => idp
      | pglue b i => kGlueOver b @ i

    -- The outer pushout needs no computation of its left map: the glue clause
    -- carries `p : P` and is discharged inside `ctrP`.
    -- BLOCKED (level inference, not mathematics). All three clauses are proved
    -- above and check individually against their stated types:
    --
    --   | pinl k  => kPath k
    --   | pinr p  => viaCtrW (ctrPW p) (pinr p)
    --   | pglue cp i => glueOverW (ctrPW cp.2) (\lam j => pglue cp j)
    --                       (kPath (qLeft cp)) (viaCtrW (ctrPW cp.2) (pinr cp.2)) @ i
    --
    -- but assembling them -- either as `\elim z` or through `Pushoutelim` with
    -- the motive `\lam (t : Qw) => cw = t` -- makes Arend demand
    -- `\lh <= constant` on the homotopy level shared by `ctrW`'s `\where` block,
    -- and that constraint then propagates out to `ctrJw0`/`ctrColB`/`ctrBase`.
    -- Pinning `hUT`/`iUT`/`gUT`/`C`/`A21`/`Kw`/`Qw` at `\oo-Type` was not enough.
    \func qPath (z : Qw) : cw = z => {?}

    \func contrQw : Contr Qw \cowith
      | center => cw
      | contraction => qPath
  }
}

