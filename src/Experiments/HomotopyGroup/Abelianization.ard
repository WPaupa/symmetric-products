\import Algebra.Group
\import Algebra.Group.GroupHom
\import Paths
\import Paths.Meta

-- The abelianization of G, presented as the commutative group generated by G
-- subject to the multiplication table of G.
--
-- This HIT presentation is convenient here: maps out of Abelianization G into
-- a commutative group are exactly group homomorphisms out of G.
\func Abelianization (G : Group) : CGroup \cowith
  | E => E
  | ide => ide
  | * => *
  | *-assoc {x} {y} {z} => path (*-assoc x y z)
  | inverse => inverse
  | ide-left {x} => path (ide-left x)
  | inverse-left {x} => path (inverse-left x)
  | *-comm {x} {y} => path (*-comm x y)
  \where {
    \truncated \data E : \Set
      | ab G

      | ide
      | \infix 7 * E E
      | *-assoc (x y z : E) : (x * y) * z = x * (y * z)
      | inverse E
      | ide-left (x : E) : ide * x = x
      | inverse-left (x : E) : inverse x * x = ide
      | *-comm (x y : E) : x * y = y * x

      | ab-* (x y : G) : ab (x G.* y) = ab x * ab y
      | ab-ide : ab G.ide = ide

    \func recE {H : CGroup} (h : GroupHom G H) (x : E) : H \elim x
      | ab g => h g
      | ide => H.ide
      | x * y => recE h x H.* recE h y
      | *-assoc x y z i =>
        H.*-assoc {recE h x} {recE h y} {recE h z} i
      | inverse x => H.inverse (recE h x)
      | ide-left x i => H.ide-left {recE h x} i
      | inverse-left x i => H.inverse-left {recE h x} i
      | *-comm x y i => H.*-comm {recE h x} {recE h y} i
      | ab-* x y i => h.func-* {x} {y} i
      | ab-ide i => h.func-ide i

    -- Universal map out of the HIT. Preservation of multiplication computes.
    \func recHom {H : CGroup} (h : GroupHom G H) :
      GroupHom (Abelianization G) H \cowith
      | func x => recE h x
      | func-* => idp

    -- The canonical quotient map G -> G_ab.
    \func quotientHom : GroupHom G (Abelianization G) \cowith
      | func g => ab g
      | func-* {x} {y} => path (ab-* x y)
      | func-ide => path ab-ide

    -- Two homomorphisms out of G_ab agree when they agree on the image of G.
    \func hom-ext {H : Group}
                  (k l : GroupHom (Abelianization G) H)
                  (onGenerators : \Pi (g : G) -> k (ab g) = l (ab g)) :
      k = l
      => exts (\lam x => pointwise x)
      \where {
        \func pointwise (x : E) : k x = l x \elim x
          | ab g => onGenerators g
          | ide => k.func-ide *> inv l.func-ide
          | x * y =>
            k.func-* {x} {y}
              *> pmap2 (\lam x y => x H.* y) (pointwise x) (pointwise y)
                   *> inv (l.func-* {x} {y})
          | inverse x =>
            k.func-inverse
              *> pmap H.inverse (pointwise x)
                   *> inv l.func-inverse
      }

    \func lift {H : CGroup} (h : GroupHom G H) :
      GroupHom (Abelianization G) H => recHom h

    \func lift-beta {H : CGroup} (h : GroupHom G H) (g : G) :
      lift h (quotientHom g) = h g => idp

    \func lift-unique {H : CGroup}
                      (h : GroupHom G H)
                      (k : GroupHom (Abelianization G) H)
                      (beta : \Pi (g : G) -> k (quotientHom g) = h g) :
      k = lift h
      => hom-ext k (lift h) beta
  }
